#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-2-Clause
"""
tests/run - every kind of MyLang test, from one entry point.

    tests/run                       the quick check: short + med tests
    tests/run -l                    list what would run (-L: everything)
    tests/run -n                    print every command it would run
    tests/run -l -d                 ... with each test's cases
    tests/run -t long               short, med and long tests
    tests/run -T fuzz               one test type (a prefix is enough)
    tests/run -f corpus             tests whose name matches a regex
    tests/run nested_fuzz rt        exactly these tests
    tests/run rt@clang              a test on another build
    tests/run rt --case '^elem2: '  only some cases of a test
    tests/run --classes             what short / med / long mean
    tests/run --builds              the builds and their recipes

A TEST is one run of one tool (rt, corpus_diff-levers, nested_fuzz...),
with a TYPE (unit, diff, fuzz, int, cli, jit, coverage, mutation), a
time CLASS and the BUILD it needs; NAME@BUILD runs it on another one.
Builds are made on demand under --build-root (incremental make;
--no-build to skip), or given with --bin BUILD=PATH, which is how CI
hands over the binaries it built. Some tests have
CASES (an -rt entry, a corpus program, a tests/int unit, a backtrace
program): a test runs as one unit unless --case selects some of them,
and a failure prints the command that reruns just the failing cases.

Passes are one line each; a failure prints the end of its output, its
log and how to reproduce it. tests/testctl shows the progress of a run.

Stdlib only.
"""

import argparse
import json
import os
import random
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(HERE, "lib"))
import testjobs  # noqa: E402
from testrun import Monitor, fmt_secs  # noqa: E402

# exit codes (named, as in Tilck's runner)
OK, BAD_ARGS, BUILD_FAILED, TESTS_FAILED, NO_TESTS, INTERRUPTED = range(6)

# ------------------------------------------------------------ classes --
# A test's CLASS is how long it runs (its build not included). The
# default run is short + med: the quick check.
CLASSES = [("short", 30), ("med", 180), ("long", 1800), ("manual", None)]
CLASS_RANK = {c: i for i, (c, _) in enumerate(CLASSES)}

TYPES = [
    ("unit", "Unit tests (-rt)"),
    ("diff", "Engine differentials"),
    ("fuzz", "Fuzzers"),
    ("int", "Intrusive tests"),
    ("cli", "Driver, system and docs"),
    ("jit", "Machine-code checks"),
    ("coverage", "Coverage gates"),
    ("mutation", "Mutation testing"),
]
TYPE_NAMES = [t for t, _ in TYPES]

# -------------------------------------------------------------- builds --
JIT_GUARD = "#if defined(__linux__) && defined(__x86_64__)"


class Lane:
    """A build: its directory is BUILD_ROOT/<name>. `expect` is what its
    `mylang -v` must say (a value or a tuple of accepted values), so a
    binary given with --bin is checked against the build it stands for.
    """

    def __init__(self, name, args, desc, kind="make", nojit=False,
                 expect=None):
        self.name, self.args, self.desc = name, args, desc
        self.kind, self.nojit = kind, nojit
        self.expect = expect or {}      # `mylang -v` key -> value


LANES = {l.name: l for l in [
    # MSVC defines no optimization macro, so a Windows debug build
    # reports `opt unknown`
    Lane("dbg", "TESTS=1 OPT=0", "debug, ASan + UBSan",
         expect={"tests": "1", "opt": ("0", "unknown"),
                 "int_tests": "0"}),
    Lane("clang", "CXX=clang++ TESTS=1 OPT=0", "debug, clang",
         expect={"tests": "1"}),
    Lane("rel-hard", "TESTS=1 OPT=1 VM_HARDENING=1",
         "optimized, asserts and VM hardening on",
         expect={"tests": "1", "vm_hardening": "1"}),
    Lane("release", "OPT=1", "the shipping build, no -rt suite",
         expect={"tests": "0", "asserts": "1"}),
    Lane("ship", "OPT=1 ASSERTS=0", "the shipping build without asserts",
         expect={"tests": "0", "asserts": "0"}),
    Lane("rna", "OPT=1 ASSERTS=0 TESTS=1", "optimized, no asserts",
         expect={"tests": "1", "asserts": "0"}),
    Lane("lto0", "OPT=1 TESTS=1 LTO=0",
         "optimized without LTO (-Wclobbered sees the whole function)",
         expect={"tests": "1", "opt": "1", "lto": "0"}),
    Lane("recycle", "TESTS=1 OPT=0 RECYCLE=1",
         "debug, the adversarial node allocator", expect={"recycle": "1"}),
    Lane("nojit-gcc", "TESTS=1 OPT=0", "debug, JIT compiled out",
         nojit=True, expect={"jit": "0"}),
    Lane("nojit-clang", "CXX=clang++ TESTS=1 OPT=0",
         "debug, clang, JIT compiled out", nojit=True, expect={"jit": "0"}),
    Lane("int-rel", "OPT=1 ASSERTS=1 LTO=0 TESTS=1 INT_TESTS=1",
         "intrusive tests, optimized",
         expect={"int_tests": "1", "asserts": "1"}),
    Lane("int-gcov", "OPT=0 TESTS=1 INT_TESTS=1 GCOV=1",
         "intrusive tests with coverage", expect={"int_tests": "1"}),
    Lane("cmake-gcov",
         "-DTESTS=1 -DGCOV=1 -DVM_HARDENING=ON -DCMAKE_BUILD_TYPE=Debug",
         "CMake coverage build (norec_coverage reads its layout)",
         kind="cmake", expect={"tests": "1"}),
]}

# --------------------------------------------------------------- tests --


class Test:
    """One run of one tool. `cmd(c)` builds the argv (c: a TestCtx, whose
    `b` is the test's binary); `cases` names a case kind (see CASES) when
    the test can run a subset. `guards` run before the tool and raise
    when the binary is not in the configuration the test is about (a
    vacuity guard); `uses` names other builds the command reads; `shard`
    turns "I/N" into the tool's own arguments for running part of it.
    An `exclusive` test runs alone on its build: a coverage tool clears
    and reads the build's gcov counters, which any other run of that
    binary would add to."""

    def __init__(self, name, type_, cls, lane, est, cmd, env=None,
                 wide=False, klass=None, cases=None, desc="", guards=(),
                 uses=(), shard=None, exclusive=False):
        self.name, self.type, self.cls, self.lane = name, type_, cls, lane
        self.est, self.cmd, self.env = est, cmd, dict(env or {})
        self.wide, self.klass, self.cases, self.desc = wide, klass, cases, desc
        self.guards, self.uses, self.shard = list(guards), list(uses), shard
        self.exclusive = exclusive

    def lanes(self):
        return [self.lane] + self.uses if self.lane else []

    def on(self, lane, cls=None, est=None):
        """This test on another build: NAME@BUILD."""
        t = Test("%s@%s" % (self.name, lane), self.type, cls or self.cls,
                 lane, est or self.est, self.cmd, self.env, self.wide,
                 self.klass, self.cases, "%s (%s build)" % (self.desc, lane),
                 self.guards, self.uses, self.shard, self.exclusive)
        return t


def T(*a):
    return os.path.join(ROOT, "tests", *a)


def S(*a):
    return os.path.join(ROOT, "scripts", *a)


def functional():
    d = T("functional")
    return sorted(os.path.join(d, f) for f in os.listdir(d)
                  if f.endswith(".my"))


def enum_corpus():
    """tests/functional plus the samples that reach a decision without
    input (phonebook and shopping read stdin, rand_sort is random)."""
    return functional() + [os.path.join(ROOT, "samples", p) for p in (
        "fib", "gcd", "loop", "primes", "primes2", "strloop")]


def myv_doc(c):
    progs = [os.path.join(ROOT, "samples", f)
             for f in sorted(os.listdir(os.path.join(ROOT, "samples")))]
    progs += [os.path.join(ROOT, "bench", "my", f)
              for f in sorted(os.listdir(os.path.join(ROOT, "bench", "my")))
              if f.endswith(".my")]
    script = "set -e; d=$(mktemp -d); " + "; ".join(
        "%s -c %s -o $d/%d.myv" % (shlex.quote(c.b), shlex.quote(p), i)
        for i, p in enumerate(progs) if os.path.isfile(p))
    script += "; %s $d/*.myv" % shlex.quote(T("myv_doc_check"))
    return ["sh", "-c", script]


# ------------------------------------------------------------- guards --
# A test of a CONFIGURATION must first prove the binary is in it, or it
# passes green testing the default the day a default moves (the reason
# the lto0 lane asserts `lto 0` first). Each guard raises with the
# reason; the test then fails without running.


def version_keys(binary, env=None):
    """`mylang -v` as a dict."""
    try:
        out = subprocess.run([binary, "-v"], capture_output=True, text=True,
                             timeout=60, env=dict(os.environ, **(env or {})))
    except OSError as e:
        raise RuntimeError("cannot run %s: %s" % (binary, e.strerror))
    got = {}
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            got[parts[0]] = parts[1]
    return got


def guard_nolowmem(c):
    """The register-form type tags: the arena is ON by default and
    MYLANG_NO_LOWMEM=1 refuses it, both directions."""
    if version_keys(c.b).get("lowmem") != "1":
        raise RuntimeError("the low-address arena is not on by default")
    if version_keys(c.b, {"MYLANG_NO_LOWMEM": "1"}).get("lowmem") != "0":
        raise RuntimeError("MYLANG_NO_LOWMEM=1 did not refuse the arena")


def guard_spcheck(c):
    """The alignment check is emitted code: it must be there under the
    lever and absent without it."""
    def vdj(env):
        return subprocess.run([c.b, "-vdj", os.path.join(ROOT, "samples",
                                                         "gcd")],
                              capture_output=True, text=True, timeout=120,
                              env=dict(os.environ, **env)).stdout
    if "test rsp, 15" not in vdj({"MYLANG_JIT_SPCHECK": "1"}):
        raise RuntimeError("MYLANG_JIT_SPCHECK=1 emitted no check")
    if "test rsp, 15" in vdj({}):
        raise RuntimeError("the alignment check is emitted WITHOUT the "
                           "lever")


# forced allocator picks that put a float stage in xmm8-15 and a GP
# scratch/pin in r8-r15 - the REX.R/X/B forms a decoder can drop and
# still print the right mnemonic. The keys name 59_float_abi_calls' two
# JIT runs.
REX_PROG = os.path.join(ROOT, "tests", "functional", "59_float_abi_calls.my")
REX_PICKS = ["main@0/fp#0=11,main@21/fp#0=11",
             "main@0/fp#1=9,main@21/fp#1=9",
             "main@0/gp#5=4,main@21/gp#2=9"]


def guard_rex(c):
    """Each forced pick must still land in r8-r15 / xmm8-15 (both runs),
    or a key the program drifted away from would check the default
    registers again."""
    for pick in REX_PICKS:
        d = tempfile.mkdtemp(prefix="mylang-rex-")
        dump = os.path.join(d, "pick.txt")
        try:
            subprocess.run([c.b, REX_PROG], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=120,
                           env=dict(os.environ, MYLANG_INT_CHOOSE=pick,
                                    MYLANG_INT_DUMP=dump))
            try:
                with open(dump) as f:
                    lines = f.read().splitlines()
            except OSError:
                lines = []
        finally:
            shutil.rmtree(d, ignore_errors=True)
        keys = set()
        for l in lines:
            if re.match(r"^choose_reg .* reg=(8|9|1[0-5])$", l):
                m = re.search(r'key="[^"]*"', l)
                if m:
                    keys.add(m.group(0))
        if len(keys) != 2:
            raise RuntimeError(
                "forced picks %s no longer land in r8-r15/xmm8-15:\n%s"
                % (pick, "\n".join(l for l in lines
                                   if l.startswith("choose_"))))


def catalog():
    ts = {}

    def add(*a, **kw):
        t = Test(*a, **kw)
        ts[t.name] = t
        return t

    def on(t, lane, est, cls="long"):
        v = t.on(lane, cls, est)
        ts[v.name] = v

    # unit: the built-in suite, in every build that compiles it in
    rt = add("rt", "unit", "med", "dbg", 80, lambda c: [c.b, "-rt"],
             cases="rt", klass="rt", desc="the built-in suite, five modes")
    for lane, est in (("clang", 90), ("rel-hard", 10), ("recycle", 90),
                      ("nojit-gcc", 60), ("nojit-clang", 60)):
        on(rt, lane, est)
    t = add("rt-nolowmem", "unit", "med", "dbg", 80,
            lambda c: [c.b, "-rt"], env={"MYLANG_NO_LOWMEM": "1"},
            guards=[guard_nolowmem], cases="rt", klass="rt",
            desc="the suite with type tags in registers")
    on(t, "rna", 10)
    t = add("rt-spcheck", "unit", "med", "dbg", 80,
            lambda c: [c.b, "-rt"], env={"MYLANG_JIT_SPCHECK": "1"},
            guards=[guard_spcheck], cases="rt", klass="rt",
            desc="the suite, every call's stack alignment checked")
    on(t, "rna", 10)

    # diff: the engines against each other
    cd = T("corpus_diff")
    add("corpus_diff", "diff", "short", "dbg", 15, lambda c: [cd, c.b],
        wide=True, cases="corpus",
        desc="every engine agrees with the tree-walker")
    for mode, cls, est, guards, lanes in (
            ("levers", "med", 90, [], ["release"]),
            ("cold", "med", 30, [], ["release"]),
            ("xrot", "med", 90, [], ["release"]),
            ("nolowmem", "short", 15, [guard_nolowmem], ["release", "rna"]),
            ("spcheck", "short", 15, [guard_spcheck], ["rna"])):
        t = add("corpus_diff-" + mode, "diff", cls, "dbg", est,
                (lambda m: lambda c: [cd, c.b, "--" + m])(mode), wide=True,
                guards=guards, cases="corpus", desc="corpus_diff --" + mode)
        for lane in lanes:
            on(t, lane, 30)
    add("bt_oracle", "diff", "med", "dbg", 60,
        lambda c: [T("bt_oracle"), c.b], cases="backtrace",
        desc="inlining never changes a backtrace")
    add("norec_enum", "diff", "med", "dbg", 90,
        lambda c: [T("norec_enum"), c.b, "--depth", "3", "--reach", "0",
                   "--jobs", str(c.share)], wide=True,
        desc="every small call-stack shape, 4 engines")
    add("norec_sweep", "diff", "med", "dbg", 150,
        lambda c: [T("norec_sweep"), c.b, "--max-events", "25",
                   "--jobs", str(c.share)], wide=True,
        desc="a forced frame rebuild at each call changes nothing")

    # fuzz: a fresh seed every run, printed in the reproduce line; a
    # finding is saved beside the logs (a .myv one cannot be regenerated)
    add("nested_fuzz", "fuzz", "med", "dbg", 90,
        lambda c: [T("nested_fuzz"), "--mylang", c.b, "--count", "250",
                   "--seed", str(c.seed), "--jobs", str(c.share)],
        wide=True, desc="random nested programs vs CPython")
    t = add("myv_fuzz", "fuzz", "med", "dbg", 60,
            lambda c: [T("myv_fuzz"), c.b, "-n", "400", "--seed",
                       str(c.seed), "--save", c.out("-bad")],
            desc="damaged .myv images never crash the loader")
    on(t, "rna", 10)
    t = add("repl_fuzz", "fuzz", "med", "dbg", 40,
            lambda c: [T("repl_fuzz"), c.b, "-n", "400", "--seed",
                       str(c.seed), "--save", c.out("-bad")],
            desc="random REPL sessions never crash it")
    on(t, "recycle", 40)

    # int: the intrusive suite
    add("int_run", "int", "long", "int-rel", 240,
        lambda c: [T("int_run"), c.b], cases="int",
        desc="tests/int, REPL sessions, census, state checkers")
    add("int-vdjcmp", "int", "long", "int-gcov", 60,
        lambda c: [S("vdjcmp"), c.bin("dbg"), c.b], uses=["dbg"],
        desc="an INT build emits what a TESTS build emits")
    for tier, cls, est in ((1, "long", 300), (2, "long", 600),
                           (3, "manual", 3600)):
        add("int_enum-%d" % tier, "int", cls, "int-rel", est,
            (lambda n: lambda c: [T("int_enum"), c.b, "--tier", str(n),
                                  "--heartbeat", "60", "--failures-out",
                                  c.out("-failures.txt")] +
             enum_corpus())(tier),
            wide=True, desc="every legal compiler decision, tier %d" % tier)

    # cli: the driver, a shipping build, the .myv spec
    t = add("driver_checks", "cli", "short", "dbg", 30,
            lambda c: [T("driver_checks"), c.b],
            desc="the command-line flags do what they say")
    for lane in ("clang", "rel-hard", "release", "rna", "int-gcov"):
        on(t, lane, 30)
    t = add("myv_doc_check", "cli", "short", "dbg", 20, myv_doc,
            desc="docs/myv-format.txt reads every image")
    for lane in ("clang", "rel-hard"):
        on(t, lane, 20)
    add("system_smoke", "cli", "long", "release", 120,
        lambda c: [T("system_smoke"), c.b],
        desc="a build with no -rt suite runs real scripts")

    # jit: the disassembler and the emitted code
    add("vdjcmp", "jit", "med", "dbg", 60,
        lambda c: [S("vdjcmp"), c.b, c.b],
        desc="-vdj is reproducible (a binary against itself)")
    add("disasmcheck", "jit", "med", "dbg", 120,
        lambda c: [S("disasmcheck"), c.b],
        desc="-vdj decodes like objdump, default config")
    add("disasmcheck-matrix", "jit", "long", "dbg", 1200,
        lambda c: [S("disasmcheck"), c.b, "--matrix"],
        shard=lambda spec: ["--shard", spec],
        desc="the same over 23 configurations")
    rex = []
    for p in REX_PICKS:
        rex += ["--env", "MYLANG_INT_CHOOSE=" + p]
    add("disasmcheck-rex", "jit", "long", "int-rel", 60,
        lambda c: [S("disasmcheck"), c.b, "--only", "tests/functional"] + rex,
        guards=[guard_rex],
        desc="the same with forced picks in r8-r15 and xmm8-15")

    # coverage
    add("int_run-gcov", "coverage", "long", "int-gcov", 600,
        lambda c: [T("int_run"), c.b, "--gcov", "--require-floor",
                   "--report", c.out("-report.txt")], cases="int",
        exclusive=True,
        desc="the coverage floor, every unit owns an element")
    add("norec_coverage", "coverage", "long", "cmake-gcov", 900,
        lambda c: [T("norec_coverage"), "--build-dir",
                   os.path.dirname(c.b), "--run",
                   "--min-lines", "70", "--min-branches", "55"],
        exclusive=True, desc="the no-record call tier's coverage floor")
    add("int_select", "coverage", "manual", "int-gcov", 1800,
        lambda c: [T("int_select"), c.b, "--with-rt", "--heartbeat", "120",
                   "--out", c.out(".json")], exclusive=True,
        desc="which tests cover what (an irredundant cover)")

    # mutation: builds its own copies of the tree
    add("mutate", "mutation", "manual", None, 3 * 3600,
        lambda c: [T("mutate"), "--count", "200", "--seed", "1"],
        shard=lambda spec: ["--shard", spec],
        desc="planted bugs are caught (CI: Mutation workflow)")
    return ts


# --------------------------------------------------------------- cases --
# kind -> (list argv, run-a-subset argv suffix, failed-case parser)


def rt_failed(out):
    """The [ RUN ] name of every case followed by [ FAIL ]; after the
    SUMMARY line the differential modes prefix the name with their tag."""
    bad, name, modes = [], None, False
    for line in out.splitlines():
        if line.startswith("SUMMARY"):
            modes = True
        elif line.startswith("[ RUN  ] "):
            name = line[9:]
            if modes:
                name = re.sub(r"^(vm-nbi|jit-nbi|vm|jit): ", "", name)
        elif line.startswith("[ FAIL ]") and name and name not in bad:
            bad.append(name)
    return bad


def corpus_failed(out):
    bad = []
    for m in re.finditer(r"^(?:DIFF|CRASH) \[[^\]]*\] (\S+)|^REFUSED (\S+)",
                         out, re.M):
        p = m.group(1) or m.group(2)
        if p not in bad:
            bad.append(p)
    return bad


def int_failed(out):
    return [m.group(1) for m in
            re.finditer(r"^  FAIL  (\S+)", out, re.M)]


def bt_failed(out):
    return [m.group(1) for m in
            re.finditer(r"^(?:FAIL|VACUOUS) ([^\s:]+)", out, re.M)]


CASES = {
    "rt": (lambda b: [b, "-rt", "--list"],
           lambda rx: ["--only", rx], rt_failed),
    "corpus": (lambda b: [T("corpus_diff"), b, "--list"],
               lambda rx: ["--only", rx], corpus_failed),
    "int": (lambda b: [T("int_run"), b, "--list"],
            lambda rx: ["--only", rx], int_failed),
    "backtrace": (lambda b: [T("bt_oracle"), b, "--list"],
                  lambda rx: ["--only", rx], bt_failed),
}


def rx_exact(names):
    """A regex matching exactly these names, in every regex dialect the
    tools speak (ECMAScript, Python, POSIX ERE)."""
    esc = [re.sub(r"([\\^$.|?*+()\[\]{}])", r"\\\1", n) for n in names]
    if len(esc) == 1:
        return "^" + esc[0] + "$"
    return "^(" + "|".join(esc) + ")$"


def list_cases(test, binary):
    """The test's cases, or None when they cannot be listed yet."""
    if not test.cases:
        return None
    if test.cases == "rt" and not os.access(binary, os.X_OK):
        return None
    try:
        out = subprocess.run(CASES[test.cases][0](binary),
                             capture_output=True, text=True, timeout=120,
                             env=dict(os.environ, MYLANG_TEST_IDLED="1"))
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    return [l for l in out.stdout.splitlines() if l]


# ---------------------------------------------------------- the runner --


class Ctx:
    def __init__(self, args, logdir, share):
        self.args, self.logdir, self.share = args, logdir, share
        self.seed = args.seed

    def bin(self, lane):
        if lane in self.args.bins:
            return self.args.bins[lane]
        return os.path.join(self.args.build_root, lane, "mylang")


class TestCtx:
    """What a test's `cmd` sees: its binary `b`, the other builds, the
    seed, its share of the cores, and a path for its own output files
    beside the logs."""

    def __init__(self, ctx, test):
        self.ctx, self.test = ctx, test
        self.b = ctx.bin(test.lane) if test.lane else None
        self.seed, self.share = ctx.seed, ctx.share

    def bin(self, lane):
        return self.ctx.bin(lane)

    def out(self, suffix):
        return os.path.join(self.ctx.logdir, self.test.name + suffix)


class Step:
    def __init__(self, name, cmd, deps=(), cost=1, klass=None, env=None,
                 est=60, test=None, cwd=ROOT, prep=None, label=None):
        self.name, self.cmd, self.deps = name, cmd, list(deps)
        self.cost, self.klass, self.env = cost, klass, dict(env or {})
        self.est, self.test, self.cwd, self.prep = est, test, cwd, prep
        self.label = label or name
        self.lanes = test.lanes() if test else []
        self.exclusive = bool(test and test.exclusive)
        self.status, self.secs, self.why = "WAIT", 0.0, ""
        self.proc = self.log = self.t0 = self.tmp = self.logfile = None
        self.case_rx = None


def make_nojit_copy(build_root):
    dst = os.path.join(build_root, "nojit-src")
    if os.path.isdir(dst):
        shutil.rmtree(dst)
    os.makedirs(dst)
    shutil.copytree(os.path.join(ROOT, "src"), os.path.join(dst, "src"))
    shutil.copy2(os.path.join(ROOT, "Makefile"), dst)
    jh = os.path.join(dst, "src", "jit.h")
    s = open(jh).read()
    if s.count(JIT_GUARD) != 1:
        raise RuntimeError("jit.h: the platform guard is not there once")
    with open(jh, "w") as f:
        f.write(s.replace(JIT_GUARD, "#if 0"))


def rel(path):
    """`path` relative to the checkout when it is inside it."""
    if path.startswith(ROOT + os.sep):
        return os.path.relpath(path, ROOT)
    return path


def check_build(binary, want):
    """`mylang -v` must say what the build's recipe says; raises with the
    reason otherwise."""
    got = version_keys(binary)
    bad = []
    for k, v in want.items():
        ok = v if isinstance(v, tuple) else (v,)
        if got.get(k) not in ok:
            bad.append("%s %s, want %s" % (k, got.get(k, "?"), " or ".join(ok)))
    if bad:
        raise RuntimeError("%s is not this build (%s)"
                           % (rel(binary), "; ".join(bad)))


def kill_tree(proc):
    """Kill a step and everything it started (its own session)."""
    try:
        if os.name == "posix":
            os.killpg(proc.pid, signal.SIGKILL)
        else:
            proc.kill()
    except OSError:
        pass


def check_steps(lanes, ctx, built):
    """One step per build: `mylang -v` must match the build's recipe, so
    a wrong --bin or a stale directory is refused, not tested."""
    steps = []
    for l in lanes:
        binary, want = ctx.bin(l), LANES[l].expect
        steps.append(Step("check:" + l, ["true"],
                          deps=["build:" + l] if l in built else [],
                          est=1, label="check " + l,
                          prep=(lambda b, w: lambda: check_build(b, w))(
                              binary, want)))
    return steps


def build_steps(lanes, build_root, jobs):
    steps = []
    per = max(1, jobs // max(1, len(lanes)))
    if any(LANES[l].nojit for l in lanes):
        steps.append(Step("nojit-src", ["true"], est=1, label="copy src",
                          prep=lambda: make_nojit_copy(build_root)))
    for l in lanes:
        lane = LANES[l]
        out = os.path.join(build_root, l)
        if lane.kind == "cmake":
            cmd = ["sh", "-c", "cmake -S %s -B %s %s >/dev/null && "
                   "cmake --build %s -j%d" % (
                       shlex.quote(ROOT), shlex.quote(out), lane.args,
                       shlex.quote(out), per)]
        else:
            src = os.path.join(build_root, "nojit-src") if lane.nojit \
                else ROOT
            cmd = ["make", "-C", src, "-j%d" % per,
                   "BUILD_DIR=" + out] + lane.args.split()
        steps.append(Step("build:" + l, cmd, cost=per, klass="build",
                          deps=["nojit-src"] if lane.nojit else [],
                          est=240, label="build " + l))
    return steps


class Out:
    """Console output: one line per finished step, the failure details,
    and on a terminal a live status line at the bottom."""

    def __init__(self, color):
        self.tty = sys.stdout.isatty()
        self.color = color and self.tty
        self.status = ""

    def c(self, code, text):
        return "\033[%sm%s\033[0m" % (code, text) if self.color else text

    def clear(self):
        if self.tty and self.status:
            sys.stdout.write("\r\033[K")
            self.status = ""

    def line(self, text=""):
        self.clear()
        print(text, flush=True)

    def set_status(self, text):
        if not self.tty:
            return
        cols = shutil.get_terminal_size((100, 20)).columns
        text = text[:cols - 1]
        sys.stdout.write("\r\033[K" + self.c("2", text))
        sys.stdout.flush()
        self.status = text


def last_line(path, span=4096):
    """The last non-empty line of a log (read from its end)."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - span))
            lines = [l.strip() for l in
                     f.read().decode(errors="replace").splitlines()
                     if l.strip()]
    except OSError:
        return ""
    return lines[-1][:120] if lines else ""


def tail_lines(path, n):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().splitlines()[-n:]
    except OSError:
        return []


def rel_arg(a):
    """An argument with the checkout's own paths made relative (inside
    a `sh -c` script too)."""
    a = a.replace(ROOT + os.sep, "")
    return re.sub(re.escape(ROOT) + r"(?=[\s'\"]|$)", ".", a)


def quote_cmd(st):
    env = " ".join("%s=%s" % (k, shlex.quote(v))
                   for k, v in sorted(st.env.items())
                   if k != "MYLANG_TEST_JOBS")
    return (env + " " if env else "") + " ".join(
        shlex.quote(rel_arg(a)) for a in st.cmd)


def reproduce(st, failed_cases):
    """The commands that rerun what failed: tests/run with the failing
    cases when the test has them, and the tool's own command line."""
    t = st.test
    if st.proc is None:         # stopped before it ran (a guard)
        return ["tests/run %s" % t.name]
    lines = []
    if t.cases and failed_cases:
        rx = rx_exact(failed_cases[:20])
        lines.append("tests/run %s --case %s" % (t.name, shlex.quote(rx)))
        base = Step(st.name, [a for a in st.cmd], env=st.env)
        if "--only" in base.cmd:        # already a --case run
            i = base.cmd.index("--only")
            del base.cmd[i:i + 2]
        base.cmd += CASES[t.cases][1](rx)
        lines.append(quote_cmd(base))
    elif t.name.startswith("nested_fuzz"):
        seeds = re.findall(r"seed=(\d+)", "\n".join(tail_lines(
            st.logfile, 400)))
        for s in seeds[:3]:
            lines.append("tests/nested_fuzz --mylang %s --seed %s "
                         "--count 1" % (shlex.quote(rel(st.cmd[2])), s))
    if not lines or not (t.cases and failed_cases):
        lines.append(quote_cmd(st))
    return lines


def run_steps(steps, jobs, caps, out, timeout, mon, show_output):
    by = {s.name: s for s in steps}
    any_tests = any(s.test for s in steps)
    used, inuse, running = 0, {}, []
    users, alone = {}, set()        # lane -> running steps; exclusive
    t0 = time.time()
    tails = [0.0, ""]               # when read, what: the running logs

    def settle():
        changed = True
        while changed:
            changed = False
            for s in steps:
                if s.status != "WAIT":
                    continue
                bad = [d for d in s.deps if by[d].status in ("FAIL", "SKIP")]
                if bad:
                    s.status = "SKIP"
                    s.why = "needs " + ", ".join(
                        by[d].label for d in bad)
                    changed = True
                    if s.test:
                        out.line("%s %-26s %s" % (
                            out.c("33", "[ SKIPPED ]"), s.label, s.why))

    while True:
        settle()
        ready = [s for s in steps if s.status == "WAIT"
                 and all(by[d].status == "PASS" for d in s.deps)]
        ready.sort(key=lambda s: -s.est)
        # a lane an exclusive step waits for takes no new users
        held = {l for s in ready if s.exclusive for l in s.lanes}
        for s in ready:
            cap = caps.get(s.klass)
            if cap is not None and inuse.get(s.klass, 0) >= cap:
                continue
            if used + s.cost > jobs and running:
                continue
            if any(l in alone for l in s.lanes):
                continue
            if s.exclusive:
                if any(users.get(l) for l in s.lanes):
                    continue
            elif any(l in held for l in s.lanes):
                continue
            if s.prep:
                try:
                    s.prep()
                except Exception as e:          # noqa: BLE001
                    s.status, s.why = "FAIL", str(e)
                    report_step(s, out, False)
                    continue
            s.log = open(s.logfile, "w")
            s.log.write("$ %s\n\n" % quote_cmd(s))
            s.log.flush()
            env = dict(os.environ)
            env.update(s.env)
            # a PRIVATE temp dir per step: -rt writes fixed names under
            # $TMPDIR, so two -rt runs sharing one would fail each other
            s.tmp = tempfile.mkdtemp(prefix="mylang-test-%s-"
                                     % s.name.replace(":", "_"))
            env["TMPDIR"] = s.tmp
            s.t0 = time.time()
            s.proc = subprocess.Popen(s.cmd, cwd=s.cwd, env=env,
                                      stdin=subprocess.DEVNULL,
                                      stdout=s.log, stderr=subprocess.STDOUT,
                                      start_new_session=True)
            s.status = "RUN"
            used += s.cost
            inuse[s.klass] = inuse.get(s.klass, 0) + 1
            for l in s.lanes:
                users[l] = users.get(l, 0) + 1
                if s.exclusive:
                    alone.add(l)
            running.append(s)
        with mon.lock:
            # count the tests; a builds-only phase (--case) counts builds
            mon.done = sum(1 for x in steps if (x.test or not any_tests)
                           and x.status in ("PASS", "FAIL", "SKIP"))
            mon.failures = sum(1 for x in steps if x.status == "FAIL")
        # the heartbeat (and testctl) show each running test's latest
        # output line: in a CI log that is the only live view of a long
        # tool, whose own progress lines go to its log file
        if time.time() - tails[0] > 5:
            tails[:] = [time.time(), "; ".join(
                "%s [%s]" % (r.label, last_line(r.logfile))
                if last_line(r.logfile) else r.label for r in running)]
        mon.set_current(tails[1])
        if not running:
            # a failure just now may have unblocked nothing but SKIPs:
            # settle once more, and stop only when nothing can start
            settle()
            if not [x for x in steps if x.status == "WAIT"
                    and all(by[d].status == "PASS" for d in x.deps)]:
                break
            continue
        st = mon.status()
        out.set_status("[%3.0f%%] %d/%d done, ETA %s  running: %s" % (
            st["percent"], st["done"], st["total"], st["eta"],
            ", ".join(r.label for r in running)))
        time.sleep(0.25)
        for s in list(running):
            rc = s.proc.poll()
            if rc is None and time.time() - s.t0 > timeout:
                kill_tree(s.proc)
                s.proc.wait()
                rc = None
                s.why = "timed out after %s" % fmt_secs(timeout)
            elif rc is None:
                continue
            else:
                s.why = "" if rc == 0 else "exit %d" % rc
            s.secs = time.time() - s.t0
            s.status = "PASS" if rc == 0 else "FAIL"
            s.log.write("\n[%s in %.1fs%s]\n" % (s.status, s.secs,
                                                 ", " + s.why if s.why
                                                 else ""))
            s.log.close()
            if s.status == "PASS":
                shutil.rmtree(s.tmp, ignore_errors=True)
            running.remove(s)
            used -= s.cost
            inuse[s.klass] -= 1
            for l in s.lanes:
                users[l] -= 1
                alone.discard(l)
            report_step(s, out, show_output)
    out.clear()
    return time.time() - t0


def report_step(s, out, show_output):
    took = human(s.secs) if s.secs >= 60 else "%.1f s" % s.secs
    if s.status == "PASS" and s.name.startswith("check:"):
        return
    if s.status == "PASS":
        tag = out.c("32", "[ PASSED  ]") if s.test else \
            out.c("32", "[ BUILT   ]")
        out.line("%s %-26s %8s" % (tag, s.label, took))
        if show_output and s.test:
            for l in tail_lines(s.logfile, 10 ** 6)[2:]:
                out.line("    " + l)
        return
    out.line("%s %-26s %8s  %s" % (out.c("31", "[ FAILED  ]"), s.label,
                                    took, s.why))
    if s.proc is None:          # failed before it ran: the reason is all
        return
    body = tail_lines(s.logfile, 10 ** 6 if show_output else 40)
    out.line()
    for l in body:
        out.line("    " + l)
    out.line()
    out.line("    log: %s" % s.logfile)
    if s.test:
        failed = CASES[s.test.cases][2]("\n".join(
            tail_lines(s.logfile, 10 ** 6))) if s.test.cases else []
        s.failed_cases = failed
        for i, r in enumerate(reproduce(s, failed)):
            out.line("    %s %s" % ("reproduce:" if i == 0 else
                                    "       or:", r))
    out.line()


# ------------------------------------------------------------ the CLI --


def human(secs):
    """30 s, 3 min, 1 h 20 min - for people, not for parsing."""
    secs = int(round(secs))
    if secs < 60:
        return "%d s" % secs
    if secs < 3600:
        m, s = divmod(secs, 60)
        return "%d min" % m if s == 0 or m >= 10 else "%d min %d s" % (m, s)
    h, m = divmod(secs // 60, 60)
    return "%d h" % h if m == 0 else "%d h %d min" % (h, m)


def times_path(build_root):
    return os.path.join(build_root, "test-times.json")


def load_times(build_root):
    try:
        with open(times_path(build_root)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_times(build_root, times):
    try:
        os.makedirs(build_root, exist_ok=True)
        tmp = times_path(build_root) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(times, f, indent=1, sort_keys=True)
        os.replace(tmp, times_path(build_root))
    except OSError:
        pass


def expected(t, times):
    h = times.get(t.name)
    if h:
        h = sorted(h)
        return h[len(h) // 2]
    return t.est


def box_table(cols, rows):
    w = [max([len(c)] + [len(r[i]) for r in rows if r is not None])
         for i, c in enumerate(cols)]
    sep = "+" + "+".join("-" * (x + 2) for x in w) + "+"
    out = [sep, "|" + "|".join(" " + c.center(x) + " "
                               for c, x in zip(cols, w)) + "|", sep]
    for r in rows:
        if r is None:
            out.append(sep)
            continue
        out.append("|" + "|".join(" " + c.ljust(x) + " "
                                  for c, x in zip(r, w)) + "|")
    out.append(sep)
    return "\n".join(out)


def do_list(sel, args, times):
    rows = []
    for ty in TYPE_NAMES:
        group = [t for t in sel if t.type == ty]
        if not group:
            continue
        for t in group:
            rows.append([t.name, t.type, t.cls, t.lane or "(own)",
                         human(expected(t, times)) if t.cls != "manual"
                         else "hours", t.desc])
        rows.append(None)
    if rows and rows[-1] is None:
        rows.pop()
    cols = ["test", "type", "class", "build", "time", "checks"]
    table = box_table(cols, rows)
    width = shutil.get_terminal_size((80, 20)).columns
    if sys.stdout.isatty() and len(table.splitlines()[0]) > width:
        # no room for the descriptions: drop that column
        table = box_table(cols[:-1], [r[:-1] if r else r for r in rows])
    print(table)
    print("%d test(s)" % len(sel))
    if not args.detailed:
        return
    ctx = Ctx(args, "", 1)
    for t in sel:
        if not t.cases:
            continue
        cases = list_cases(t, ctx.bin(t.lane))
        print()
        if cases is None:
            print("%s: cases listed once its build exists (%s)"
                  % (t.name, t.lane))
            continue
        if args.case:
            rx = re.compile(args.case)
            cases = [c for c in cases if rx.search(c)]
        print("%s: %d case(s)" % (t.name, len(cases)))
        for c in cases:
            print("    " + c)


def parse_args(cat):
    ap = argparse.ArgumentParser(
        prog="tests/run",
        usage="tests/run [options] [TEST[@BUILD] ...] [-- TOOL-ARGS]",
        description="Run MyLang's tests (see tests/README.md).",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("tests", nargs="*", metavar="TEST",
                    help="run exactly these tests (names from -L); "
                         "NAME@BUILD runs a test on another build")
    g = ap.add_argument_group("selecting")
    g.add_argument("-t", "--max-class", default="med",
                   choices=[c for c, _ in CLASSES if c != "manual"] +
                   ["any"],
                   help="run tests up to this time class (default: med)")
    g.add_argument("-T", "--type", default=None,
                   help="only these test types, comma-separated; a "
                        "prefix is enough (%s)" % ", ".join(TYPE_NAMES))
    g.add_argument("-f", "--filter", default=None, metavar="REGEX",
                   help="only tests whose name the regex matches")
    g.add_argument("--case", default=None, metavar="REGEX",
                   help="only these cases of the selected tests (-rt "
                        "entries, corpus programs, tests/int units, "
                        "backtrace programs)")
    g.add_argument("-a", "--allow-manual", action="store_true",
                   help="also run manual tests (hours: mutation, tier 3)")
    g = ap.add_argument_group("listing")
    g.add_argument("-l", "--list", action="store_true",
                   help="list the tests that would run, and stop")
    g.add_argument("-L", "--list-all", action="store_true",
                   help="list every test (same as -l -t any -a)")
    g.add_argument("-d", "--detailed", action="store_true",
                   help="with -l: also list each test's cases")
    g.add_argument("--classes", action="store_true",
                   help="list the time classes and the test types")
    g.add_argument("--builds", action="store_true",
                   help="list the builds, their recipes and what each "
                        "binary's `mylang -v` must say")
    g = ap.add_argument_group("running")
    g.add_argument("-n", "--dry-run", action="store_true",
                   help="print the builds, checks and every test's command "
                        "line, and run nothing")
    g.add_argument("-o", "--show-output", action="store_true",
                   help="show each test's whole output, even on success")
    g.add_argument("-j", "--jobs", type=int, default=0,
                   help="cores to use (default: tests/jobs count)")
    g.add_argument("--seed", type=int, default=None,
                   help="the fuzzers' seed (default: a fresh one)")
    g.add_argument("--timeout", type=int, default=3 * 3600,
                   help="per-test timeout in seconds (default 3 hours)")
    g.add_argument("--shard", default=None, metavar="I/N",
                   help="run part I (from 0) of N of each selected test "
                        "(those that can split: %s)" % ", ".join(
                            sorted(n for n, t in cat.items() if t.shard)))
    g = ap.add_argument_group("builds")
    g.add_argument("--build-root",
                   default=os.environ.get("MYLANG_TEST_BUILD_ROOT",
                                          os.path.join(ROOT, "build-tests")),
                   help="where the builds, logs and timings live "
                        "(default: build-tests/, or "
                        "$MYLANG_TEST_BUILD_ROOT)")
    g.add_argument("--no-build", action="store_true",
                   help="build nothing; skip tests whose build is missing")
    g.add_argument("--bin", action="append", default=[],
                   metavar="BUILD=PATH",
                   help="use this binary for a build instead of making it")
    g.add_argument("--logs", default=None,
                   help="log directory (default: BUILD_ROOT/test-logs/"
                        "<time>)")
    g.add_argument("--no-color", action="store_true")
    # after `--`: arguments for the one selected test's tool, appended
    # to its command line (a CI workflow's inputs, an extra flag)
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    args = ap.parse_args(argv)
    args.extra = extra
    if args.shard is not None:
        m = re.fullmatch(r"(\d+)/(\d+)", args.shard)
        if not m or not int(m.group(1)) < int(m.group(2)):
            ap.error("--shard wants I/N with 0 <= I < N")
    args.build_root = os.path.abspath(args.build_root)
    args.bins = {}
    for spec in args.bin:
        lane, _, path = spec.partition("=")
        if lane not in LANES or not path:
            ap.error("--bin wants BUILD=PATH with BUILD one of %s"
                     % ", ".join(LANES))
        args.bins[lane] = os.path.abspath(path)
    if args.list_all:
        args.list, args.max_class, args.allow_manual = True, "any", True
    args.seed_given = args.seed is not None
    if args.seed is None:
        args.seed = random.SystemRandom().randrange(1, 10 ** 9)
    return args


def select(cat, args):
    """(selected tests, why-not hints)."""
    if args.tests:
        for n in args.tests:
            # NAME@BUILD: a catalog test on another build
            base, _, lane = n.rpartition("@")
            if n in cat or base not in cat or not cat[base].lane:
                continue
            if lane == cat[base].lane:
                cat[n] = cat[base]
            elif lane in LANES:
                cat[n] = cat[base].on(lane)
        unknown = [n for n in args.tests if n not in cat]
        if unknown:
            for n in unknown:
                near = [m for m in cat if n in m]
                print("tests/run: no test named %r%s" % (
                    n, " (did you mean: %s?)" % ", ".join(near[:5])
                    if near else " (tests/run -L lists them, "
                    "--builds the builds for NAME@BUILD)"))
            sys.exit(BAD_ARGS)
        sel = [cat[n] for n in args.tests]
        manual = [t.name for t in sel if t.cls == "manual"]
        if manual and not args.allow_manual and not args.list:
            print("tests/run: %s %s hours long (a manual test); add -a to "
                  "run %s" % (", ".join(manual),
                              "runs" if len(manual) == 1 else "run",
                              "it" if len(manual) == 1 else "them"))
            sys.exit(BAD_ARGS)
        return sel
    sel = list(cat.values())
    if args.type:
        want = set()
        for p in args.type.split(","):
            m = [t for t in TYPE_NAMES if t.startswith(p.strip())]
            if len(m) != 1:
                print("tests/run: -T %r matches %s (types: %s)" % (
                    p, "nothing" if not m else "several",
                    ", ".join(TYPE_NAMES)))
                sys.exit(BAD_ARGS)
            want.add(m[0])
        sel = [t for t in sel if t.type in want]
    if args.filter:
        rx = re.compile(args.filter)
        sel = [t for t in sel if rx.search(t.name)]
    pre_class = list(sel)
    maxr = 99 if args.max_class == "any" else CLASS_RANK[args.max_class]
    sel = [t for t in sel if CLASS_RANK[t.cls] <= maxr
           or (t.cls == "manual" and args.allow_manual)]
    sel = [t for t in sel if t.cls != "manual" or args.allow_manual]
    if not sel and pre_class:
        print("tests/run: no test up to class %s matches; these match at "
              "a longer one:" % args.max_class)
        for t in pre_class:
            print("    %-24s %s" % (t.name, t.cls))
        print("add -t long, or -t any -a for the manual ones")
        sys.exit(NO_TESTS)
    return sel


def main():
    # a console that cannot encode a log's text (Windows' cp1252) gets
    # a replacement character, not an exception
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass
    cat = catalog()
    args = parse_args(cat)
    if args.classes:
        for c, secs in CLASSES:
            print("  %-7s %s" % (c, "up to %s" % human(secs) if secs
                                  else "hours (needs -a; CI: on demand)"))
        print()
        for t, d in TYPES:
            print("  %-9s %s" % (t, d))
        return OK
    if args.builds:
        for l in LANES.values():
            want = ", ".join("%s %s" % (k, "|".join(v) if isinstance(
                v, tuple) else v) for k, v in l.expect.items())
            print("  %-12s %s\n  %-12s %s%s: %s\n  %-12s mylang -v: %s"
                  % (l.name, l.desc, "", l.kind,
                     " (jit.h's guard off)" if l.nojit else "", l.args,
                     "", want))
        return OK
    sel = select(cat, args)
    if args.case and not args.list:
        sel = [t for t in sel if t.cases]
        if not sel:
            print("tests/run: --case needs a test with cases (%s)" %
                  ", ".join(sorted({t.name for t in cat.values()
                                    if t.cases})))
            return BAD_ARGS
    if not sel:
        print("tests/run: no test matches")
        return NO_TESTS
    if args.shard:
        bad = [t.name for t in sel if not t.shard]
        if bad:
            print("tests/run: --shard: %s cannot be split (these can: %s)"
                  % (", ".join(bad), ", ".join(sorted(
                      n for n, t in cat.items() if t.shard))))
            return BAD_ARGS
    if args.extra and len(sel) != 1:
        print("tests/run: the arguments after -- go to one test's tool; "
              "%d tests are selected" % len(sel))
        return BAD_ARGS
    times = load_times(args.build_root)
    if args.list:
        do_list(sel, args, times)
        return OK

    if not args.dry_run:
        testjobs.ensure_idle()
    jobs = args.jobs if args.jobs > 0 else testjobs.count()
    # a wide test runs its own pool: up to three at once, but never with
    # fewer than four workers each - on a small box (a 4-core CI runner
    # gets 2) they run one after another at full width, since a split
    # share is fixed at start and the longer test would keep half the
    # cores after the shorter one is done
    k = max(1, min(3, sum(1 for t in sel if t.wide), jobs // 4))
    share = max(1, jobs // k)
    out = Out(color=not args.no_color and not os.environ.get("NO_COLOR"))
    stamp = time.strftime("%Y%m%d-%H%M%S")
    logdir = os.path.abspath(args.logs or os.path.join(
        args.build_root, "test-logs", stamp))
    latest = os.path.join(os.path.dirname(logdir), "latest")
    try:
        if not args.dry_run:
            os.makedirs(logdir, exist_ok=True)
        if not args.dry_run and not args.logs and (os.path.islink(latest)
                              or not os.path.exists(latest)):
            if os.path.islink(latest):
                os.unlink(latest)
            os.symlink(logdir, latest)
    except OSError:
        pass
    ctx = Ctx(args, logdir, share)

    # the builds the selection uses; those not given by --bin are made
    # (incrementally) unless --no-build, and every one is checked
    skipped = []
    if args.no_build:
        for t in list(sel):
            gone = [l for l in t.lanes()
                    if not os.access(ctx.bin(l), os.X_OK)]
            if gone:
                skipped.append((t, "no %s build (%s)" % (
                    gone[0], ctx.bin(gone[0]))))
                sel.remove(t)
    need = sorted({l for t in sel for l in t.lanes()})
    build = [] if args.no_build else [l for l in need if l not in args.bins]
    if args.dry_run:
        return dry_run(sel, args, ctx, need, build, skipped, jobs, share,
                       times)

    caps = {"rt": testjobs_cap("rtcap"), "build": testjobs_cap("buildcap")}
    out.line("tests/run: %d test(s), %d build(s), %d cores, seed %d" % (
        len(sel), len(build), jobs, args.seed))
    for l in need:
        if l in args.bins:
            out.line("build %s: %s (--bin)" % (l, rel(args.bins[l])))
    out.line("logs: %s" % logdir)
    for t, why in skipped:
        out.line("%s %-26s %s" % (out.c("33", "[ SKIPPED ]"), t.name, why))
    out.line()

    def assign_logs(ss):
        for x in ss:
            if not x.logfile:
                x.logfile = os.path.join(logdir,
                                         x.name.replace(":", "_") + ".log")

    steps = build_steps(build, args.build_root, jobs)
    steps += check_steps(need, ctx, build)
    assign_logs(steps)
    if args.case:
        # the cases exist only once the builds do: build first
        if steps:
            run_steps(steps, jobs, caps, out, args.timeout,
                      Monitor("run", total=len(steps), phase="builds",
                              heartbeat=60).__enter__(), False)
            if any(s.status != "PASS" for s in steps):
                return BUILD_FAILED
            steps = []
            need = []
    for t in sel:
        st = test_step(t, ctx, args, share, need, times)
        cmd = st.cmd
        if args.case:
            cases = list_cases(t, ctx.bin(t.lane))
            rx = re.compile(args.case)
            hit = [c for c in (cases or []) if rx.search(c)]
            if not hit:
                out.line("%s %-26s no case matches %r" % (
                    out.c("33", "[ SKIPPED ]"), st.label, args.case))
                continue
            st.cmd = cmd + CASES[t.cases][1](rx_exact(hit))
        steps.append(st)
    assign_logs(steps)
    tests_run = [s for s in steps if s.test]
    if not tests_run:
        out.line("tests/run: nothing to run")
        return NO_TESTS

    # progress counts TESTS, weighted by their expected time: a build
    # that is already up to date finishes at once and says nothing
    # about how far along the run is
    total_w = float(sum(min(s.est, 3600) for s in tests_run)) or 1.0

    def pct():
        return 100.0 * sum(min(s.est, 3600) for s in tests_run
                           if s.status in ("PASS", "FAIL", "SKIP")) \
            / total_w
    mon = Monitor("run", total=len(tests_run), phase="tests",
                  heartbeat=60, percent_fn=pct)
    try:
        with mon:
            wall = run_steps(steps, jobs, caps, out, args.timeout, mon,
                             args.show_output)
    except KeyboardInterrupt:
        out.clear()
        for s in steps:
            if s.status == "RUN":
                kill_tree(s.proc)
        print("\ntests/run: interrupted; logs in %s" % logdir)
        return INTERRUPTED

    # the timing record: the last five runs of each test
    for s in tests_run:
        # only whole, unmodified runs say how long a test takes
        if s.status == "PASS" and not (args.case or args.shard
                                       or args.extra):
            h = times.get(s.name, [])[-4:] + [round(s.secs, 1)]
            times[s.name] = h
    save_times(args.build_root, times)

    return summary(steps, skipped, wall, logdir, out)


def test_step(t, ctx, args, share, need, times):
    """The step that runs test `t` - what a run executes and what a dry
    run prints."""
    tc = TestCtx(ctx, t)
    cmd = t.cmd(tc)
    if args.shard:
        cmd += t.shard(args.shard)
    cmd += args.extra
    env = dict(t.env)
    if t.wide:
        env["MYLANG_TEST_JOBS"] = str(share)
    if t.lane and LANES[t.lane].expect.get("int_tests") == "1":
        # driver_checks pins `int_tests 0` unless told otherwise
        env["MYLANG_EXPECT_INT_TESTS"] = "1"
    return Step(t.name, cmd, deps=["check:" + l for l in t.lanes()
                                   if l in need],
                cost=share if t.wide else 1, klass=t.klass,
                env=env, est=expected(t, times), test=t,
                label="%s: %s" % (t.type, t.name),
                prep=(lambda g, c: lambda: [f(c) for f in g])(
                    t.guards, tc) if t.guards else None)


def dry_run(sel, args, ctx, need, build, skipped, jobs, share, times):
    """Print what a run would do, in the order it would do it, and do
    none of it: no build, no check, no test, no log directory."""
    print("tests/run: dry run - nothing is built or run")
    print("%d test(s), %d build(s), %d cores, seed %d%s" % (
        len(sel), len(build), jobs, args.seed,
        "" if args.seed_given else " (a run draws a fresh one; --seed N "
        "fixes it)"))
    if build:
        print()
        print("builds (incremental):")
        steps = build_steps(build, args.build_root, jobs)
        for st in steps:
            if st.name == "nojit-src":
                print("  copy src/ and the Makefile to %s, jit.h's platform "
                      "guard set to #if 0" % rel_arg(os.path.join(
                          args.build_root, "nojit-src")))
            else:
                print("  " + quote_cmd(st))
    if need:
        print()
        print("binary checks (mylang -v must say):")
        for l in need:
            want = ", ".join("%s %s" % (k, "|".join(v) if isinstance(
                v, tuple) else v) for k, v in LANES[l].expect.items())
            print("  %-12s %s%s" % (l, rel_arg(ctx.bin(l)) + ": ", want))
    for t, why in skipped:
        print("not run: %s - %s" % (t.name, why))
    print()
    print("tests:")
    total = 0.0
    for t in sel:
        st = test_step(t, ctx, args, share, need, times)
        notes = [t.cls, "~" + human(st.est)]
        total += st.est
        if t.wide:
            notes.append("%d workers" % share)
        if t.exclusive:
            notes.append("alone on its build")
        if t.guards:
            notes.append("first checks: " + ", ".join(
                g.__name__.replace("guard_", "") for g in t.guards))
        print("  %s  [%s]" % (st.label, "; ".join(notes)))
        cmd = quote_cmd(st)
        if args.case:
            cases = list_cases(t, ctx.bin(t.lane))
            if cases is None:
                cmd += "  # + --only <the cases matching %s>" % shlex.quote(
                    args.case)
            else:
                rx = re.compile(args.case)
                hit = [c for c in cases if rx.search(c)]
                cmd = (quote_cmd(Step(st.name, st.cmd + CASES[t.cases][1](
                    rx_exact(hit)), env=st.env)) if hit
                       else "# no case matches %r" % args.case)
        print("      " + (cmd if len(cmd) < 400 else cmd[:397] + "..."))
    print()
    print("the tests' expected times add up to %s; they run side by side "
          "on %d cores (builds not included)" % (human(total), jobs))
    return OK


def testjobs_cap(what):
    try:
        r = subprocess.run(["sh", os.path.join(HERE, "jobs"), what],
                           capture_output=True, text=True, check=True)
        return max(1, int(r.stdout.strip()))
    except (OSError, ValueError, subprocess.CalledProcessError):
        return 2


def summary(steps, skipped, wall, logdir, out):
    tests = [s for s in steps if s.test]
    builds_bad = [s for s in steps if not s.test and s.status == "FAIL"]
    out.line("-" * 72)
    for ty, pretty in TYPES:
        group = [s for s in tests if s.test.type == ty]
        if not group:
            continue
        ok = sum(1 for s in group if s.status == "PASS")
        bad = [s.test.name for s in group if s.status == "FAIL"]
        skip = [s.test.name for s in group if s.status == "SKIP"]
        note = ""
        if bad:
            note += out.c("31", "  FAILED: " + ", ".join(bad))
        if skip:
            note += out.c("33", "  skipped: " + ", ".join(skip))
        out.line("%-26s passed: %3d/%-3d%s" % (pretty, ok, len(group), note))
    if skipped:
        out.line("%-26s %s" % ("Not run (no build)", ", ".join(
            t.name for t, _ in skipped)))
    failed = [s for s in tests if s.status == "FAIL"]
    out.line()
    verdict = out.c("32", "PASSED") if not failed and not builds_bad \
        else out.c("31", "FAILED")
    out.line("%s: %d/%d tests passed in %s; logs in %s" % (
        verdict, sum(1 for s in tests if s.status == "PASS"), len(tests),
        human(wall), rel(logdir)))
    if failed:
        out.line()
        out.line("to reproduce:")
        for s in failed:
            for r in reproduce(s, getattr(s, "failed_cases", [])):
                out.line("    " + r)
    if builds_bad:
        return BUILD_FAILED
    return TESTS_FAILED if failed else OK


if __name__ == "__main__":
    sys.exit(main())
