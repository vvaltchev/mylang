# a 4-deep chain of expression-bodied inlinees
func d4(x) => 1000 / (x - 7);
func d3(x) => d4(x + 1) + 1;
func d2(x) => d3(x * 2) - 2;
func d1(x) => d2(x - 1) * 3;
func outer(int n) {
    var s = 0;
    for (var i = 0; i < n; i++)
        s = s + d1(runtime(i));
    return s;
}
print(outer(runtime(6)));
