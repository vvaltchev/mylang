# the int-algebra fold (it runs with the inliner, so -ni skips it) drops
# no throwing term: `x * 0` and `t - t` keep the division's throw
func drive(int m) {
    var s = 0;
    for (var i = 0; i < m; i++) {
        s = s + (m / (m - 1 - i)) * 0;
        s = s + m / (m - 2 - i) - m / (m - 2 - i);
    }
    return s;
}
print(drive(runtime(4)));
