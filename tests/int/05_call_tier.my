# INT-ENGINES: default
# INT-CONFIGS: MYLANG_BCINLINE_TYPED=0
#
# INT test (#107 P2): the JIT records the PROTOCOL it emitted for each call
# site (`call_tier`). The callees take DECLARED ints and hold a loop or a
# recursion, so the AST inliner (a loop is over its cost) leaves the calls,
# and the config above keeps the bytecode inliner from taking a typed
# callee - this tests the call, not the inliner. Default engine only: no
# JIT elsewhere.

func leaf(int x) {                          # a LEAF: frameless
    var s = 0;
    for (var i = 0; i < 3; i++) s += x;
    return s;
}
var calls = 0;
func rec(int n) {                           # a CALLING body: frameless too
    calls++;                                #   (#97 G1); IMPURE, or the
    if (n < 2) { return n; }                #   AST inliner unrolls it
    var a = rec(n - 1);
    var b = rec(n - 2);
    return a + b;
}
func drive(int n) {
    var s = 0;
    for (var i = 0; i < n; i++) { var t = leaf(i); s += t; }
    var r = rec(n);
    return s + r;
}
var res = drive(int(runtime(10)));          # main -> drive: the push
print(res);
assert(res == 135 + 55);

var ev = int_events("call_tier");
foreach (e in ev) print(e);
func has(arr, needle) {
    foreach (e in arr)
        if (find(e, needle) != none) return true;
    return false;
}
assert(has(ev, "tier=\"frameless\" callee=\"leaf\" line=26"));
assert(has(ev, "tier=\"frameless\" callee=\"rec\" line=20"));
assert(has(ev, "tier=\"frameless\" callee=\"rec\" line=21"));
assert(has(ev, "tier=\"frameless\" callee=\"rec\" line=27"));
assert(has(ev, "tier=\"push\" callee=\"drive\" line=30"));
