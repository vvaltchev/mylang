# INT-ENGINES: tw default nj nbi
#
# INT unit (plans/strict-container-types.md, rule 4): a container only
# `dyn` reached that takes an array<int> / array<float> / array<bool>
# type as it enters a typed place becomes FLAT (flatten_general), and
# every typed read, store and loop over it then works on the flat
# storage. A CONSTANT's row is read-only and takes no type, so a typed
# array can still hold general storage that way: its typed reads and
# loops must use what it holds, as a flat one's would (a float read of
# an int or a bool, a foreach). And a multi-assignment whose targets are
# declared checks each value it unpacks from an array whose element type
# is not filled yet (Expr14's IdList fit checks). The tree-walker is
# the oracle; every engine must agree.

var bad = 0;
func want(what, got, exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected " + str(exp));
        bad++;
    }
}

func asf(array<float> a) => a;
func asi(array<int> a) => a;
func asb(array<bool> a) => a;
array<dyn> src = [[1.5, "x"], [1, "x"], [true, "x"]];
var dyn f0 = src[0];
f0[1] = 2.5;
var dyn i0 = src[1];
i0[1] = 2;
var dyn b0 = src[2];
b0[1] = false;
array<float> fa = asf(f0);
array<int> ia = asi(i0);
array<bool> ba = asb(b0);
want("storages", array_storage(fa) + array_storage(ia) + array_storage(ba),
     "floatintbool");

# typed reads of a constant's general rows
const ROWS = [1.5, 2.5, "x", 1, 2, "x", true, false, "x"];
var dyn cf = ROWS[0:2];
var dyn ci = ROWS[3:5];
var dyn cb = ROWS[6:8];
array<float> gfa = asf(cf);
array<int> gia = asi(ci);
array<bool> gba = asb(cb);
want("a constant's rows", array_storage(gfa) + array_storage(gia)
                              + array_storage(gba),
     "generalgeneralgeneral");
var fs = 0.0;
for (var k = 0; k < len(gfa); k++)
    fs += gfa[k];
want("float reads", fs, 4.0);
float fb = 0.5 + gba[0];
want("a bool read as a float", fb, 1.5);
float fi = 0.25 * gia[1];
want("an int read as a float", fi, 0.5);
var gsum = 0;
foreach (x in gia)
    gsum += x;
want("foreach a constant's ints", gsum, 3);
var gbc = 0;
foreach (b in gba)
    if (b)
        gbc++;
want("foreach a constant's bools", gbc, 1);
# the fused element ops on them: a branch on an element
# (JumpUnlessElemInt) and a counted loop that reads one (ForStepElemInt)
var nb = 0;
for (var k = 0; k < len(gba); k++)
    if (gba[k])
        nb++;
want("a branch on a constant's bool", nb, 1);
var ni = 0;
for (var k = 0; k < len(gia); k++)
    if (gia[k])
        ni++;
want("a branch on a constant's int", ni, 2);
var st = 0;
for (var k = 0; k < len(gia); k++) {
    var e = gia[k];
    st += e * 10;
}
want("a counted loop over a constant's ints", st, 30);
var bt = 0;
for (var k = 0; k < len(gba); k++) {
    var e = gba[k];
    bt += e ? 1 : 0;
}
want("a counted loop over a constant's bools", bt, 1);
# a loop whose body ends in a store keeps its plain step, which the
# element read fuses into (ForStepElemInt) - an int read, a bool read as
# an int
var outi = [0, 0];
for (var k = 0; k < len(gia); k++) {
    var e = gia[k];
    outi[k] = e * 10;
}
want("ForStepElemInt over a constant's ints", outi, [10, 20]);
var outb = [0, 0];
for (var k = 0; k < len(gba); k++)
    outb[k] = gba[k] * 3;
want("ForStepElemInt over a constant's bools", outb, [3, 0]);
# a store into a constant's row is refused (it is read-only)
var ro = "";
try {
    gfa[0] = 0.5;
} catch (NotLValueEx) {
    ro = "L";
}
want("a store into a constant's float row", ro, "L");

# a row that is none takes no type as its array enters an
# array<array<int>?>; the other row becomes flat
func asno(array<array<int>?> a) => a;
array<dyn> nsrc = [[none, [1]]];
var dyn nr = nsrc[0];
array<array<int>?> nra = asno(nr);
want("a none row", nra[0] == none, true);
want("...and the other row's storage", array_storage(nra[1]), "int");

# typed stores, plain and compound
ia[0] = 7;
ia[1] += 3;
fa[0] = 0.5;
fa[1] *= 2.0;
want("int stores", str(ia), "[7, 5]");
want("float stores", str(fa), "[0.500000, 5.000000]");

# loops
var isum = 0;
foreach (x in ia)
    isum += x;
want("foreach ints", isum, 12);
var bc = 0;
foreach (b in ba)
    if (b)
        bc++;
want("foreach bools", bc, 1);

# a multi-assignment into declared targets checks what it unpacks from
# an array whose element type is not filled yet (empty arrays): each
# value takes its target's type as it lands
array<int> p = [9];
array<int> q = [9];
var pairs = [[], []];
p, q = pairs;
append(p, 1);
want("unpacked", str(p) + str(q), "[1][]");
# (an empty untyped array takes the type too, and flat storage)
want("storage as it landed", array_storage(p), "int");

# a `dyn?` element of a literal fits an element that may be none
array<int?> lq = [runtime(none), runtime(3)];
want("dyn? elements", str(lq), "[<none>, 3]");

# a dict a builtin makes where `dyn` is declared is the dynamic dict
var dyn dmk = make_dict(["a"], func(str k) => 1);
dmk["b"] = "s";
want("a dynamic dict", str(dmk), "{\"a\": 1, \"b\": \"s\"}");

assert(bad == 0);
print("ok");
