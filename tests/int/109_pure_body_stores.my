# INT-ENGINES: tw default nj noopt nc
#
# INT unit (#107): an explicit `pure` function's stores into DECLARED
# places are widened by the parser (pure_stamp_stores / pure_place_annot),
# because a call with constant arguments RUNS while parsing, before
# inference. Each place kind is here - a dict value, a field of a nested
# struct, an element of a declared float array (plain and compound), a
# multi-declaration and a multi-assignment, a foreach variable, a catch
# binding, a for loop's own variable, and an element of a container no
# declaration states - and the constant call must print exactly what the
# same call made at run time prints, in every engine (RULE 2).

struct In { float v; }
struct Out { In inner; int n; }

pure func f(int k) {
    dict<str, float> d = {"a": 0.5};
    d["b"] = k;
    Out o;
    o.inner.v = k;
    var a, b = [k, 2];
    var q = [1];
    q[0] = k;
    array<float> fs = [0.5, 1.5];
    fs[0] += k;
    a, b = [b, a];
    var s = 0.0;
    foreach (x in fs)
        s = s + x;
    try {
        throw In(0.25);
    } catch (In as e) {
        s = s + e.v;
    }
    for (var i = 0; i < 2; i++)
        s = s + i;
    var dyn y = {"z": 1};
    y["z"] = k;
    return str(d["b"]) + " " + str(o.inner.v) + " " + str(a) + str(b)
         + " " + str(q[0]) + " " + str(fs[0]) + " " + str(s) + " "
         + str(y["z"]);
}

const C = f(3);
const R = "3.000000 3.000000 23 3 3.500000 6.250000 3";
assert(C == R);
assert(f(int(runtime(3))) == R);
print(C);
