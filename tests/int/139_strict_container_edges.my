# INT-ENGINES: tw default nj noopt
#
# INT unit (plans/strict-container-types.md, rules 1, 3, 4 and choice 6):
# the edges of the strict container rules that no functional program
# reaches - a `dyn?` value stored into an inferred container, a builtin's
# new container into a nullable place, an untyped dict or class array
# walked by a run-time fit check against a `dyn?` / `dyn` component, a
# generic `array` component met by a typed one, a multi-assignment that
# spreads one untyped dict into two declared targets, array(n) of a
# struct with a box field, a general-storage int / bool array tested by
# `if (a[k])`, a foreach body holding an inlined call and a `return`. The
# tree-walker is the oracle; every engine must agree.

var bad = 0;
func want(str what, opt dyn got, opt dyn exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}
var typed = typestr(runtime(0)) == "dyn";

# ---- a `dyn?` value stored into an INFERRED container: checked at run
# time (the element type stays the one the program gave it)
var w = [1];
var dyn? q = runtime(5);
w[0] = q;
want("dyn? into an inferred element", str(w), "[5]");
var dyn? qn = runtime([none])[0];
var wn = 0;
try { w[0] = qn; } catch (TypeErrorEx) { wn = 1; }
want("a none refused", wn, 1);
var kd = {1: 2};
var dyn? qk = runtime(3);
kd[qk] = 4;
want("dyn? key", str(kd), "{1: 2, 3: 4}");

# ...and one whose type, during inference, is the `dyn?` it may be: the
# inferred element type takes it
var w2 = [1];
var dyn? q2 = runtime(none);
w2[0] = q2;
want("a dyn? element", str(w2), "[<none>]");
if (typed)
    want("a dyn? element type", typestr(w2), "array<dyn?>");

# ---- keys() of an empty dict of strings (no hint: strings keep their
# own storage)
dict<str, int> es = {};
var ek = keys(es);
want("keys of an empty dict", len(ek), 0);

# ---- a builtin's new container into a NULLABLE place of its type
array<int>? oa = runtime(true) ? [1] : none;
array<int>? ob = clone(oa);
want("clone into an opt place", str(ob), "[1]");

# ---- a builtin's dict made for a `dyn` parameter
func fd(dyn d) => len(d);
want("dict for a dyn parameter", fd(dict(5)), 0);

# ---- a builtin's dict assigned to a `dyn` variable: dynamic
var dyn xd = 1;
xd = dict(5);
xd["k"] += 1;
want("dict(5) into a dyn variable", str(xd), "{\"k\": 6}");

# ---- a literal for an array<float> holding dyn ints and bools: each
# widens, and the array is flat
array<float> fa = [runtime(1), runtime(true), 2.5];
want("widened", str(fa), "[1.000000, 1.000000, 2.500000]");
if (typed)
    want("flat floats", array_storage(fa), "float");

# ---- a lambda nothing calls: its parameter is unknown, so a local copy
# of it that is also given a string is a string that received a `dyn`
var ls = [func(p) { var y = p; if (runtime(false)) y = "s"; return y; }];
want("an uncalled lambda", len(ls), 1);

# ---- an untyped dict (only `dyn` reached it) entering a dict whose
# values may be anything: its keys are walked, its values are not
array<dyn> dsrc = [{1: "a"}, {2: 3}];
func kv(dict<int, dyn?> d) => len(d);
var dyn du = dsrc[0];
want("dict<int, dyn?> walk", kv(du), 1);
var dyn dbad = runtime([{"x": 1}])[0];
var dbr = 0;
try { kv(dbad); } catch (TypeErrorEx) { dbr = 1; }
want("a str key refused", dbr, 1);

# ---- an untyped class array entering an array<dyn>: each element is
# walked (a class instance is never none)
class C { int n; }
array<dyn> csrc = [[C(1), C(2)]];
func ad(array<dyn> a) => len(a);
var dyn cu = csrc[0];
want("class elements into array<dyn>", ad(cu), 2);

# ---- a container typed with a generic `array` component entering a
# typed one: exact types, refused at the bind through `dyn`
array<array> g = [[1]];
func h(array<array<int>> a) => len(a);
var dyn gd = g;
var gr = 0;
try { h(gd); } catch (TypeErrorEx) { gr = 1; }
want("array<array> into array<array<int>>", gr, 1);

# ...while a generic `array` component of the PLACE takes any element
# type, a `dyn` one included
func hh(array<array> a) => len(a);
array<array<dyn>> v = [[1]];
var dyn vd = v;
want("array<array<dyn>> into array<array>", hh(vd), 1);

# ---- a multi-assignment that spreads one value - an untyped dict - into
# two declared targets: each is checked and both hold the same dict
dict<str, int> m1 = {"a": 1};
dict<str, int> m2 = {"b": 2};
var esrc = {};
m1, m2 = esrc;
m1["z"] = 3;
want("one dict in two targets", str(m2), "{\"z\": 3}");

# ---- a template's base body is not checked (its instances are): an
# array(n) there whose element type has no zero value is made untyped
func tz(x) { array<dyn> a = array(2); return len(a) + x; }

# ---- array(n) with no destination to take a type from: nones
want("array(n) with no destination", str(array(2)), "[<none>, <none>]");

# ---- array(n) of a struct with a box field: a box of its own per element
struct BX { box<int> b; }
array<BX> bxs = array(2);
*bxs[0].b = 5;
want("box per element", str(*bxs[0].b) + str(*bxs[1].b), "50");

# ---- `if (a[k])` over a GENERAL int and bool array (one only `dyn`
# reached, which took the typed place's type as it entered)
func asi(array<int> a) => a;
func asb(array<bool> a) => a;
array<dyn> gsrc = [[1, "x"], [true, "x"]];
var dyn gi = gsrc[0];
gi[1] = 0;
var dyn gb = gsrc[1];
gb[1] = false;
array<int> gia = asi(gi);
array<bool> gba = asb(gb);
var nz = 0;
for (var k = 0; k < len(gia); k++)
    if (gia[k])
        nz++;
for (var k = 0; k < len(gba); k++)
    if (gba[k])
        nz += 10;
want("if (a[k]) over general storage", nz, 11);

# ---- template calls whose results are not known in the first round
# give a template a dict argument whose key, then value, is unsettled
func gid(x) => x;
func tk(d) => len(d);
var dk1 = {gid(1): 2};
var dv1 = {1: gid(2)};
want("open dict arguments", tk(dk1) + tk(dv1), 2);

# ---- a value-used template's base runs boxed: an array<dyn> literal
# of a template call's result is checked as it is made
func tb(x) { array<dyn> a = [gid(x)]; return len(a); }
var dyn tf = tb;
want("a value-used base", tf(1) + tf("s"), 2);

# ---- a foreach whose body holds an inlined call and returns from it
func blk(int v) { if (v > 3) return 1; return 0; }
func firstbig(array<int> xs) {
    foreach (x in xs)
        if (blk(xs[0]) + x > 4)
            return x;
    return -1;
}
want("foreach with an inlined call", firstbig([4, 2, 9]), 4);
struct P { int x; }
func firstp(array<P> ps) {
    foreach (p in ps)
        if (blk(ps[0].x) + p.x > 4)
            return p.x;
    return -1;
}
want("struct foreach with an inlined call", firstp([P(4), P(9)]), 4);

assert(bad == 0);
print("ok");
