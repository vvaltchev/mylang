func sp(int a, int mode) {
    var t = a * 2
    if (mode > 0) {
        return t + mode
    }
    return t - mode
}
func usesp(int n) {
    return sp(n, 3) + sp(n, -1)
}
usesp(runtime(5))
func tmpl(a, b) => a + b
tmpl(1, 2)
tmpl(1.5, 2)
func tc(const a, b) => a * b
tc(2, 3)
func tv(a) { print(a); }
tv(7)
