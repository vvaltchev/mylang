>> array<dyn> func locs(int n) {
    P p = P(n, 2);
    opt P q = n > 9 ? p : none;
    array<int>? b = n > 9 ? [n] : none;
    array<P> ps = [p];
    dict<str,int> d = {"k": n};
    box<float> bx = box(1.5);
    box<int>? bn = n > 9 ? box(n) : none;
    opt int o = n > 9 ? n : none;
    var dyn t = n;
    var opt dyn u = n > 9 ? n : none;
    bool bb = n > 1;
    str s = str(n);
    float fl = n;
    K k = K(n);
    opt K ok = n > 9 ? k : none;
    var a1, a2 = [n, 2];
    int i1, i2 = [n, 3];
    a1, a2 = [a2, a1];
    a1 += i2;
    struct L {
        int a;
        opt dyn z;
        array<float> fs;
        box<int>? bi;
        P p;
        K k;
    }
    var l = L(1, none, [1.5], none, p, k);
    bool nn = q == none && b == none && bn == none && o == none && u == none && ok == none && bb && len(s) == 1;
    return [p.x, len(ps), d["k"], int(*bx), t, a1, a2, i1, l.a, k.v, nn ? 1 : 0, int(fl)];
}
