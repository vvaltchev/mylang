# :show renders the shapes the other :show sessions leave out: a call
# the block inliner pasted into an expression (an `inlined` block), a
# closure with a capture list, a counted `for` with no init or with an
# init that declares nothing, a `foreach` whose loop variable is written
# without `var`, and locals typed by their initializer alone (a float, a
# bool, an empty array of a struct declared in the body).
func g2(x) {
    var t = x
    t++
    return t
}
func use2(int y) {
    var z = g2(y) * 2
    return z
}
use2(4)
:show use2
func mk(int a) {
    return func [a] (b) => a + b
}
mk(1)(2)
:show mk
func loops(int n) {
    var s = 0
    var i = 0
    for (i = 0; i < n; i++) {
        s += i
    }
    for (; i < 2 * n; i++) {
        s += 1
    }
    foreach (e in [1, 2]) {
        s += e
    }
    return s
}
loops(3)
:show loops
func lits(int n) {
    var f = 2.5
    f = f * n
    var b = true
    b = !b
    struct Q { int a; }
    var qs = []
    append(qs, Q(n))
    return [f, b, len(qs)]
}
lits(2)
:show lits
