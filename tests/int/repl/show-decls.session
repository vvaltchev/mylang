# :show renders every declared annotation (reflect_decl_annot) - of a
# parameter, a local, a multi-declaration - and every field type of a
# struct declared in a body (reflect_field_type); signature() and layout()
# read the same renderings. Constants a body names are BAKED values the
# decompiler writes back as code: floats that read back as the same
# double, arrays, dicts, POD and slot structs, class instances, and
# cyclic constants, whose back edge renders as the print form does.
struct P { int x; int y; }
struct N { str n; int v; }
class K { int v; }
struct Q { bool b; int i; float f; str s; array a; dict d; dyn y; box<int> bx; P p; opt dyn od; opt array oa; opt dict odc; array<int>? ai; dict<str, int> di; box<float>? bf; opt K ok; }
signature(Q)
foreach (var f in layout(Q).fields) { print(f.name + ": " + f.type); }
func pa(P p, opt P q, array<int> a, array<int>? b, dict<str, P> d, box<int> bx, opt int o, dyn x, opt dyn y, bool bb, str s, float f, opt K k) => a[0] + p.x
pa(P(1, 2), none, [3], none, {}, box(1), none, 0, none, true, "", 1.5, none)
:show pa
signature(pa)
func locs(int n) {
    P p = P(n, 2)
    opt P q = n > 9 ? p : none
    array<int>? b = n > 9 ? [n] : none
    array<P> ps = [p]
    dict<str, int> d = {"k": n}
    box<float> bx = box(1.5)
    box<int>? bn = n > 9 ? box(n) : none
    opt int o = n > 9 ? n : none
    var dyn t = n
    var opt dyn u = n > 9 ? n : none
    bool bb = n > 1
    str s = str(n)
    float fl = n
    K k = K(n)
    opt K ok = n > 9 ? k : none
    var a1, a2 = [n, 2]
    int i1, i2 = [n, 3]
    a1, a2 = [a2, a1]
    a1 += i2
    struct L { int a; opt dyn z; array<float> fs; box<int>? bi; P p; K k; }
    var l = L(1, none, [1.5], none, p, k)
    var nn = (q == none) && (b == none) && (bn == none) && (o == none) &&
        (u == none) && (ok == none) && bb && len(s) == 1
    return [p.x, len(ps), d["k"], int(*bx), t, a1, a2, i1, l.a, k.v,
            nn ? 1 : 0, int(fl)]
}
locs(runtime(4))
:show locs
pure func ring(n) { var dyn r = [n, "x"]; r[1] = r; return r; }
const RING = ring(1)
pure func dring(n) { var dyn d = dict({"z": n}); d["me"] = d; return d; }
const DR = dring(2)
const PP = P(5, 6)
const NN = N("a", 7)
const KK = K(8)
const FL = [1.5, 0.1, 1e300, -0.0, 2.0]
const FX = [inf, -inf, nan, math_pi]
const DD = {"a": 1}
const D2 = {"b": [2.5], "c": 3}
func vals() {
    var r = [RING]
    var e = [DR]
    var s = [PP, PP]
    var n = [NN]
    var k = [KK]
    var f = [FL]
    var x = [FX]
    var d = [DD, D2]
    return [len(r), len(e), len(s), len(n), len(k), len(f), len(d), len(x)]
}
vals()
:show vals
func h1(int a) { var t = a; t++; return t; }
func u1(int n) => h1(n) * 2
u1(runtime(3))
:show u1
