# :show renders a function's declarations with their keywords: a const
# container local (kept as a symbol), a `const dyn` one, an annotated
# const, an opt dyn variable, and an inferred const with no hint.
func f(int k) {
    const A = [1, 2, 3];
    const dyn D = [1, "a"];
    const array<int> T = [4, 5];
    var opt dyn o = runtime(k > 0 ? k : none);
    const M = {"a": [1]};
    return len(A) + len(D) + len(T) + (o ?? 0) + len(M);
}
f(runtime(2))
:show f
# ... and the keyword inferred from the value: a flat struct array, a
# string, a bool, an `opt` variable with no type, a multi-declaration,
# and a `const` with no type at all (a function).
struct P { int x; int y; }
func g(int k) {
    var ps = [P(k, 1), P(2, k)];
    var s = "x";
    s = s + str(k);
    var opt w;
    w = k;
    var b = k > 1;
    b = !b;
    var a, c = [k, 2];
    a, c += [1, 1];
    const G = pure func(y) => y * 2;
    return len(ps) + len(s) + (w ?? 0) + (b ? 1 : 0) + a + G(c);
}
g(runtime(2))
:show g
