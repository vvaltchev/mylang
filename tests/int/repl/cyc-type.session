# :type of an expression is its RUNTIME structural type (README, the
# REPL's Reflection bullet; reflect.cpp.h reflect_typeof): every value
# kind and storage - flat, general, homogeneous or not, empty, nested,
# dicts, struct types, instances, functions, a caught exception - and a
# value that contains itself, whose back edge reads as `dyn`. Every ring
# built here is broken at the end.
struct P { int x; int y; }
struct N { int v; dyn? next; }
class C { int v; array<C> kids; }
:type [true, false]
:type [1, 2]
:type [1.5, 2.5]
:type ["s", "t"]
:type split("a b c", " ")
:type [P(1, 2), P(3, 4)]
:type [N(1, none), N(2, none)]
:type [1, "x"]
:type [none, 1]
:type dynarray([])
:type dynarray([[1], [2, 3]])
:type ({})
:type ({"k": [1.5]})
:type ({1: {"in": true}})
:type none
:type 2.5
:type true
:type "s"
:type len
:type 0; P
:type C(1, [])
:type N(1, none)
:type [func (x) { return x; }][0]
:type [pure func (int a, opt str b) => a][0]
var dyn ex = none
try { var dyn z = 1 / runtime(0); } catch (DivisionByZeroEx as e) { ex = e; }
:type 0; ex
var dyn a = dynarray([1])
append(a, a)
:type 0; a
:type 0; [a, a]
var dyn a2 = dynarray([])
append(a2, a2)
:type 0; a2
var dyn d = {}
d["me"] = d
:type 0; d
:type 0; [d]
var dyn r2 = dynarray([0])
r2[0] = {"back": r2}
:type 0; r2
pop(a)
pop(a2)
erase(d, "me")
r2[0] = 0
