>> /* pure */ int func loops(int n) {
    int s = 0;
    int i = 0;
    for (i = 0; i < n; i++) {
        s += i;
    }
    for (; i < n * 2; i++) {
        s += 1;
    }
    foreach (var e in [1, 2]) {
        s += e;
    }
    return s;
}
