>> /* pure */ func loops(n) {
    int s = 0;
    int i = 0;
    while (i < n) {
        i++;
        s += i;
    }
    for (var j = n; j > 0; j--) {
        s -= j;
    }
    for (int k = 0; k < n; k += 2) {
        s *= 1;
    }
    for (int k = 10; k >= 0; k -= 3) {
        s += k;
    }
    for (int k = 0; k <= 2; k++) {
        s++;
    }
    return s;
}

