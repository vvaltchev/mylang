>> /* pure */ func each(arr) {
    int t = 0;
    foreach (var v in arr) {
        t += v;
    }
    foreach (var i, v in indexed arr) {
        t += i * v;
    }
    foreach (var _ in arr) {
        t--;
    }
    return t;
}

