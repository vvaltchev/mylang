# INT-ENGINES: tw default nj noopt
#
# INT unit (strict item 1 and choice 2, 2026-11-27): the places that
# decide an `array(n)`'s element type - a variable, a declared parameter,
# a struct field (a `dyn` one decides nothing), a declared container's
# element through a store / append / push / insert, a `?:` / `??` arm -
# and the ones that do not (a parameter nothing declares, a call through
# a function value, a template base's body, a multi-assignment, a
# compound); and the builtins the callee-set analysis follows through
# (the reads-only list, append / push / insert, and the ones whose result
# comes out of their first argument), each at the arity it models and at
# one it does not. The tree-walker is the oracle; every engine must agree.

var bad = 0;
func want(str what, opt dyn got, opt dyn exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}

# --- places that decide it
func tparam(array<int> a, b) => str(a) + typestr(b);
want("declared + undeclared parameters", tparam(array(2), array(1)),
     "[0, 0]array<dyn?>");
var fv = tparam;
want("through a function value", fv(array(1), 5), "[0]int");

struct S2 { dyn d; array<float> a; }
var s2 = S2(array(1), array(2));
want("a field, after a dyn one", s2.a, [0.0, 0.0]);
var dyn? s2d = s2.d;
want("the dyn field decides nothing", s2d, [none]);

array<array<str>> ms = [["x"]];
append(ms, array(1));
push(ms, array(2));
insert(ms, 0, array(1));
want("append / push / insert", ms, [[""], ["x"], [""], ["", ""]]);
dict<str, array<int>> md = {};
insert(md, "k", array(2));
want("insert into a dict value", md["k"], [0, 0]);
# (an inferred container is no declared place: the array(1) is an
# array<dyn?>, and the fresh literal joins it - rule 4)
var mi = [[1]];
append(mi, array(1));
want("append into an inferred container", typestr(mi),
     "array<array<dyn?>>");

var cc = int(runtime(1)) > 0;
array<int> ta = cc ? array(2) : array(3);
array<int> tb = array(1) ?? [7];
want("arms", [ta, tb], [[0, 0], [0]]);

# --- what decides nothing
func tf(x) { var a = array(2); a[0] = x; return a; }
want("template instances", [typestr(tf(1)), typestr(tf("s"))],
     ["array<int>", "array<str>"]);
var ma, mb = [array(1), array(2)];
want("a multi-assignment", [typestr(ma), typestr(mb)],
     ["array<dyn?>", "array<dyn?>"]);
var two = array(2, 7);
want("array(n, v)", two, [7, 7]);

# --- the builtins the callee analysis follows through
func sq(int x) => x * x;
func neg(int x) => 0 - x;
var fs = [sq];
want("sort / rev_sort / reverse", [sort(fs)[0](2), rev_sort(fs)[0](3),
     reverse(fs)[0](4)], [4, 9, 16]);
want("clone / deepclone", [clone(fs)[0](5), deepclone(fs)[0](6)],
     [25, 36]);
var fd = {"a": neg};
want("values / get / get! / find", [values(fd)[0](1), get(fd, "a")(2),
     get!(fd, "a")(3), find(fd, "a")(4)], [-1, -2, -3, -4]);
var fs2 = [neg, sq];
want("top / min / max", [top(fs2)(5), min([sq])(6), max([neg])(7)],
     [25, 36, -7]);
var dyn mm = min(runtime(3), runtime(2));
want("min of two", mm, 2);
want("pop", pop(fs2)(8), 64);
var gs = [];
var dyn ret = append(gs, neg);
want("append's result", ret[0](9), -9);
var ps = [];
var dyn pret = push(ps, sq);
want("push's result", pret[0](3), 9);
var dyn mx = max(runtime(3), runtime(5));
want("max of two", mx, 5);
# a closure template's instance called directly, returning a function
var kb = 10;
var mkf = func [kb] (x) { return func [x] () => x + 1; };
want("an instance's function result", mkf(4)(), 5);
want("reads-only builtins", [len(fs), typestr(sq)], [1, "func(int)->int"]);
# ...and the arities that call back: opaque
want("find with a key", find(fs, sq, func(e) => e), 0);
want("sort with a comparator", sort([3, 1], func(x, y) => x < y), [1, 3]);
want("erase", erase(fs2, 0), true);

assert(bad == 0);
print("array(n) places: ok");
