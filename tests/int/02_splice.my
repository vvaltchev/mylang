# INT-ENGINES: default
#
# INT test (#107 P2): the bytecode splice records one `splice` event per
# (call site, candidate callee) - `spliced`, or the reason it declined.
# Each verdict below is asserted at its exact call site. The bodies hold
# a loop so the AST inliner (which runs first) leaves the calls alone.
# Default engine only: the splice is bytecode codegen, which the tree-
# walker never runs, so it records nothing there. `run` takes a DECLARED
# int: in a template instance the callee-set analysis names nothing for
# `e(1)` (only the base's site gets an answer, top), so no value splice.

func lp(x) {
    var s = 0;
    for (var i = 0; i < x; i++) s += i;
    return s;
}
func lpv(x) {                              # no return: a void body
    var s = 0;
    for (var i = 0; i < x; i++) s += i;
}
func opt2(x, opt y) {                      # called with the opt omitted
    var s = 0;
    for (var i = 0; i < x; i++) s += i;
    return s;
}
func typed(int x) {                        # a declared type: inlined,
    var s = 0;                             # the bind kept as a coercion
    for (var i = 0; i < x; i++) s += i;
    return s;
}
func mk(x) => func [x] (y) { return x + y; };

func run(int n) {
    var a = lp(n);                         # spliced (call)
    var b = lpv(n);                        # void_result_used
    lpv(n);                                # spliced (discarded)
    var d = opt2(n);                       # arity
    var t = typed(n);                      # spliced (typed param)
    var e = mk(n);                         # spliced (factory)
    return a + d + t + e(1);               # spliced (value)
}
var r = run(int(runtime(4)));
var tp = lp(int(runtime(3)));             # main_not_factory
print(r, tp);
assert(r == 23 && tp == 3);

var ev = int_events("splice");
foreach (e in ev) print(e);

func has(arr, needle) {
    foreach (e in arr)
        if (find(e, needle) != none) return true;
    return false;
}
assert(has(ev, "verdict=\"spliced\" kind=\"call\" callee=\"lp\" line=34"));
assert(has(ev, "verdict=\"void_result_used\" kind=\"call\" callee=\"lpv\" line=35"));
assert(has(ev, "verdict=\"spliced\" kind=\"call\" callee=\"lpv\" line=36"));
assert(has(ev, "verdict=\"arity\" kind=\"call\" callee=\"opt2\" line=37"));
assert(has(ev, "verdict=\"spliced\" kind=\"call\" callee=\"typed\" line=38"));
assert(has(ev, "verdict=\"spliced\" kind=\"call\" callee=\"mk\" line=39"));
assert(has(ev, "verdict=\"spliced\" kind=\"value\" callee=\"<lambda>\" line=40"));
assert(has(ev, "verdict=\"main_not_factory\" kind=\"call\" callee=\"lp\" line=43"));

# The decision behind it is ENUMERATED (`splice_choice`, #107 P3): one instance
# per site that would be taken, pick 0 takes it, 1 declines - and
# tests/int_enum.py forces each decline. Unforced, every instance takes
# its default.
var dec = int_events("splice_choice");
var dec_ok = len(dec) > 0;
foreach (e in dec)
    if (find(e, "pick=0") == none)
        dec_ok = false;
print(dec_ok);
assert(dec_ok);
