# INT-ENGINES: default
#
# INT test (#107 P3): `reg_choice`, the decision enumerator's instance
# record - one event per register pick among several legal ones, keyed
# `<function>/<gp|fp>#<ordinal>`. tests/int_enum.py reads these from a
# default run to plan its deviations, so what this pins is the contract
# it relies on: an instance is recorded for both register files of the
# function that picked, and with no MYLANG_INT_CHOOSE every pick is the
# heuristic's own (`pick` == `dflt`), naming a register of the file.

func acc(int n) {
    var a = 0;
    var b = 1;
    var f = 0.5;
    for (var i = 0; i < n; i++) {
        a = a + i;
        b = b ^ a;
        f = f * 1.5 + 0.25;
    }
    return a + b + int(f) % 7;
}
var r = acc(int(runtime(20)));
print(r);
assert(r == 313);

var ev = int_events("reg_choice");
func field(e, name) {
    var parts = split(e, " ");
    foreach (p in parts)
        if (startswith(p, name + "="))
            return p[len(name) + 1:];
    return "";
}
var gp = 0;
var fp = 0;
foreach (e in ev) {
    assert(field(e, "pick") == field(e, "dflt"));
    var reg = int(field(e, "reg"));
    assert(reg >= 0 && reg < 16);
    if (startswith(field(e, "key"), "\"acc/gp#")) gp++;
    if (startswith(field(e, "key"), "\"acc/fp#")) fp++;
}
print(gp > 0, fp > 0);
assert(gp > 0 && fp > 0);
