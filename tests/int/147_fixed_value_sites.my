# INT-ENGINES: tw default nc
#
# INT unit (question 22, README *A read of a constant has the type of what
# it reads*): the sites that record a constant read's value - a member, a
# subscript, a slice, a builtin call (pNoteFixed) - and the ones that do
# not: a read whose value names a function or a builtin, a call given a
# function or reaching a user function, a read whose evaluation fails
# (in an arm the parser drops), a slice with an omitted bound. Under -nc
# each read's value is recorded by nc_eval_const instead of the fold.
# With no types (-nti) typestr names a run-time type, so the type checks
# are made in a typed run only.
var typed = typestr(runtime(0)) == "dyn";
var bad = 0;
func want(str what, opt dyn got, opt dyn exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}
func wantt(str what, str got, str exp) {
    if (typed)
        want(what, got, exp);
}

pure func sq(int x) => x * x;
pure func lt(int a, int b) => a < b;
const M = [3, "a", 2.5];
const D = {"a": 1, "b": "s"};
const OPS = [sq];
const NF = [[sq], 7];
const BS = [len, abs];

# ---- a nested read, a read after a read, a slice with an open bound
wantt("a nested member read", typestr(D.b), "str");
wantt("a slice to the end", typestr(M[1:]), "array<dyn>");
wantt("a slice from the start", typestr(M[:1]), "array<int>");
want("its value", M[:1][0] + 1, 4);

# ---- a builtin call given a function, or a name bound to one, is typed
# by the builtin; one given data by its value
wantt("sort given a named function", typestr(sort([2, 1], lt)),
      "array<int>");
wantt("len of a sort given a function literal",
      typestr(len(sort([2, 1], pure func(a, b) => a < b))), "int");
wantt("len of constants", typestr(len(M)), "int");
want("a builtin over a nested fixed call", sum(sort([3, 1, 2])), 6);

# ---- a read whose value names a function, a builtin, or holds one
want("a function read", OPS[0](3), 9);
want("an array holding one", len(NF[0]), 1);
want("a builtin read", BS[1](-4), 4);

# ---- a call to a user function in an index, and its result
want("a user call in an index", M[sq(1) - 1], 3);
wantt("...typed by the program", typestr(sq(2)), "int");

# ---- a read whose evaluation fails, in an arm the parser drops
want("a dropped arm", true ? 1 : D.zz, 1);

# ---- a member of a value that is not constant
var r = {"n": int(runtime(5))};
want("a run-time member", r.n + 1, 6);

# ---- the builtins' own rules, reached by calls that are not constant
# (a constant one has its value's type, and asks no rule)
var x = 0.5 + int(runtime(0));
want("exp", exp(x) > 1.6, true);
want("cbrt", cbrt(x * 16), 2.0);
want("cos", cos(x * 0), 1.0);
want("tan", tan(x * 0), 0.0);
want("asin", asin(x * 0), 0.0);
want("acos", acos(x * 2), 0.0);
want("atan", atan(x * 0), 0.0);
want("ceil", ceil(x), 1.0);
want("trunc", trunc(x + 1), 1.0);
want("isfinite", isfinite(x), true);
want("isnormal", isnormal(x), true);
var dr = {"k": int(runtime(4))};
want("get! of a dict that is not constant", get!(dr, "k") + 1, 5);
wantt("...is not opt", typestr(get!(dr, "k")), "int");

# ---- a constant call to a user function whose value is none: the late
# fold puts the none where the program has an int?
const K = [1, none];
pure func pick(int n) {
    if (n > 0)
        return K[0];
    return K[1];
}
var p0 = pick(0);
want("a folded none", p0, none);
wantt("...typed by the program", typestr(p0), "int?");

# ---- a `??` whose left side becomes a literal only when a write-once
# variable is promoted
var a5 = 5;
var on = none;
want("a promoted left side", a5 ?? 3, 5);
want("a promoted none left side", on ?? 4, 4);

assert(bad == 0);
