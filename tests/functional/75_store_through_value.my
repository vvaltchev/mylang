# A store through a value that is not a variable - a call's result, a
# literal, a ternary, a slice - goes into that value, as if it were first
# bound to a fresh variable: `f()[0] = v` is `{ var t = f(); t[0] = v; }`,
# and an in-place builtin's first argument too (`append(f(), x)`).
# A container is a reference, so the write lands in the object returned.
# The tree-walker raised NotLValueEx for an array or a struct (and stored
# into a dict), the VM refused to compile it, and an inlined `f` made it a
# store through a variable. Each callee loops so that neither inliner
# takes it: the store really goes through a call's result.

func spin(int n) { var k = n; while (k > 1000) k -= 1; return k; }

var trail = "";
func t(str s, int v) { trail += s; return v; }

var ga = ["a", "b", "c"];
var gi = [1, 2, 3];
var gf = [1.5, 2.5];
var gb = [true, false];
var gd = {"k": 1};
func fa(int n) { spin(n); return ga; }
func fi(int n) { spin(n); return gi; }
func ff(int n) { spin(n); return gf; }
func fb(int n) { spin(n); return gb; }
func fd(int n) { spin(n); return gd; }

# 1. plain, compound, inc-dec and value stores into each array kind
fa(runtime(1))[0] = "z";
fi(runtime(1))[1] = 20;
fi(runtime(1))[2] += 5;
fi(runtime(1))[0]++;
--fi(runtime(1))[0];
ff(runtime(1))[1] = 4;
fb(runtime(1))[1] = true;
assert(ga == ["z", "b", "c"] && gi == [1, 20, 8]);
assert(gf == [1.5, 4.0] && gb == [true, true]);
var v1 = (fi(runtime(1))[1] = 7);
var v2 = (fi(runtime(1))[1] += 3);
var v3 = fi(runtime(1))[1]++;
var v4 = ++fi(runtime(1))[1];
var v5 = (ff(runtime(1))[0] = 2);
assert(v1 == 7 && v2 == 10 && v3 == 10 && v4 == 12 && gi[1] == 12);
assert(v5 == 2.0 && gf[0] == 2.0);
print(ga, gi, gf, gb, v1, v2, v3, v4, v5);

# 2. a dict, by key and by member
fd(runtime(1))["k"] = 5;
fd(runtime(1)).k += 1;
fd(runtime(1))["new"] = 9;
fd(runtime(1)).k++;
assert(gd["k"] == 7 && gd["new"] == 9);
print(gd["k"], gd["new"]);

# 3. structs: a POD one, a boxed one, inline and boxed nested fields
struct In { int x; }
struct Pod { int a; In sub; }
struct Box { str s; In sub; array<int> arr; }
var gp = Pod(1, In(2));
var gx = Box("s", In(3), [4, 5]);
func fp(int n) { spin(n); return gp; }
func fx(int n) { spin(n); return gx; }
fp(runtime(1)).a = 10;
fp(runtime(1)).sub.x += 5;
fp(runtime(1)).a++;
fx(runtime(1)).s = "t";
fx(runtime(1)).sub.x = 30;
fx(runtime(1)).arr[1] = 50;
fx(runtime(1)).arr[0] += 1;
var v6 = (fp(runtime(1)).sub.x = 8);
assert(gp.a == 11 && gp.sub.x == 8 && v6 == 8);
assert(gx.s == "t" && gx.sub.x == 30 && gx.arr == [5, 50]);
print(gp, gx);

# 4. nested arrays, and a flat struct array's element
var gn = [[1, 2], [3, 4]];
var gs = [In(1), In(2)];
func fn(int n) { spin(n); return gn; }
func fs(int n) { spin(n); return gs; }
fn(runtime(1))[1][0] = 30;
fn(runtime(1))[0][1] *= 10;
fs(runtime(1))[1].x = 20;
fs(runtime(1))[0].x += 4;
fs(runtime(1))[0].x--;
assert(gn == [[1, 20], [30, 4]] && gs[0].x == 4 && gs[1].x == 20);
print(gn, gs);

# 5. other bases: a ternary, a closure call, a struct construction, a
#    literal; a fresh object takes the write and is gone with the store
var c = runtime(1) > 0;
var gh = [0, 0];
(c ? gi : gh)[0] = 100;
(c ? gh : gi)[1] = 200;
var cl = func [gh] (int n) { spin(n); return gh; };
cl(runtime(1))[1] += 7;
var w1 = (In(runtime(1)).x = 41);
var w2 = ([1, spin(runtime(2))][1] += 40);
assert(gi[0] == 100 && gh == [0, 207] && w1 == 41 && w2 == 42);
print(gi, gh, w1, w2);
# a small callee at a store root stays a call (the AST inliner leaves
# it, section 10), and the inc-dec's value comes from the object it wrote,
# not a second one
func lit2() { return [9, 8]; }
var w3 = ++lit2()[1];
var w4 = lit2()[0]--;
assert(w3 == 9 && w4 == 9);
print(w3, w4);

# 6. a copy is a copy: a slice detaches, clone() made a new array, and a
#    slice held in a named local is not the one written
gi = [1, 2, 3];
gi[0:runtime(2)][0] = 99;
clone(gi)[1] = 99;
var sl = [0];
(sl = gi[0:2])[0] = 77;
assert(gi == [1, 2, 3] && sl == [1, 2]);
print(gi, sl);

# 7. the order: the rhs, then the base, then each key
func fl(int n) { trail += "f"; return gn; }
fl(runtime(1))[t("1", 0)][t("2", 1)] = t("v", 5);
fl(runtime(1))[t("k", 1)] = [t("v", 6)];
fd(runtime(1))[str(t("k", 3))] = t("v", 1);
assert(trail == "vf12vfkvk" && gn[0][1] == 5 && gn[1] == [6]);
print(trail);

# 8. a const value refuses the write as through a variable, and a string
#    is not a container
const CA = [1, 2];
func fc(int n) { spin(n); return CA; }
var e1 = "none";
try { fc(runtime(1))[0] = 5; } catch (NotLValueEx) { e1 = "notlvalue"; }
var e2 = "none";
var cv = fc(runtime(1));
try { cv[0] = 5; } catch (NotLValueEx) { e2 = "notlvalue"; }
assert(e1 == e2 && CA == [1, 2]);
print(e1, e2);

# 9. an in-place builtin works on a value the same way: append(f(), x) is
#    { var t = f(); append(t, x); } - the value evaluated first
var gq = [1, 2];
var gm = {"a": 1, "b": 2};
func fq(int n) { spin(n); return gq; }
func fm(int n) { spin(n); return gm; }
append(fq(runtime(1)), 3);
push(fq(runtime(1)), 4);
var p1 = pop(fq(runtime(1)));
insert(fq(runtime(1)), 0, 0);
erase(fq(runtime(1)), 1);
reverse(fq(runtime(1)));
erase(fm(runtime(1)), "a");
insert(fm(runtime(1)), "c", 3);
append(fn(runtime(1))[0], 9);
trail = "";
append(fl(runtime(1))[1], t("v", 7));
var same = intptr(fq(runtime(1))) == intptr(gq);
append([spin(runtime(1)), 2], 3);
var p2 = pop([spin(runtime(5)), 6]);
assert(gq == [3, 2, 0] && p1 == 4 && gm == {"b": 2, "c": 3});
assert(gn == [[1, 5, 9], [6, 7]] && trail == "fv" && same && p2 == 6);
print(gq, p1, gn, trail, same, p2);
var e3 = "none";
try { append(fc(runtime(1)), 3); } catch (CannotChangeConstEx) { e3 = "c"; }
var e4 = "none";
try { append(cv, 3); } catch (CannotChangeConstEx) { e4 = "c"; }
assert(e3 == "c" && e4 == "c" && CA == [1, 2]);
print(e3, e4);

# 10. the value is a COPY where a copy and the variable differ: a slice
#     view's copy detaches on a write, a flat struct element read is a
#     copy. These callees are small enough to inline, so the AST inliner
#     must leave a call at a store root a call - inlined, the store would
#     land in `sv` or `ge[0]` itself.
var base = [1, 2, 3];
var sv = base[0:2];
func gsv() { return sv; }
gsv()[0] = 9;
gsv()[1]++;
append(gsv(), 5);
var ge = [In(1), In(2)];
func gel() { return ge[0]; }
gel().x = 40;
gel().x += 1;
assert(sv == [1, 2] && base == [1, 2, 3] && ge[0].x == 1);
print(sv, base, ge);
