# #74: a foreach unpack over GENERAL rows with consecutive targets
# (`foreach (var i, a, b in indexed rows)`, 75_indexed_unpack's shape) is
# one UnpackElemValue whose JIT tier borrows the row from rows[i], checks
# its length once and copies each element into its target. Every shape it
# binds or declines must print what the tree-walker prints:
#  - string rows, and the body REPLACING the row it just unpacked (the next
#    bind then finds the target holding the LAST reference to its old
#    string: the cold full release);
#  - every element kind: int, float, str, array, dict, a closure, none;
#  - a SLICE container, a SLICE row, a FLAT (split) row, a SLICE element,
#    an EXCEPTION element - each declines to the helper;
#  - a row of the WRONG LENGTH: the strict error, caught - including a
#    short VIEW of a parent that HAS N elements, which only the row-slice
#    guard tells from a right-length row.
var rows = [];
for (var j = 0; j < 6; j++)
    append(rows, ["n" + str(j), str(j * 2)]);
var acc = 0;
for (var r = 0; r < 4; r++)
    foreach (var i, a, b in indexed rows) {
        acc += i + len(a) + len(b);
        rows[i] = [a + "!", b];
    }
print("strings", acc, rows[5][0]);

var mix = [[1, 2.5], [3, 4.5]];
var dyn kinds = [[1, "s"], [2.5, [1, 2]], [{"k": 1}, none],
                 [func() => 7, true]];
var fs = 0.0;
foreach (var p, q in mix) fs += p + q;
var n = 0;
foreach (var p, q in kinds) n += 1;
print("kinds  ", fs, n);

var cont = [["a", "b"], ["c", "d"], ["e", "f"]];
var sl = cont[1:3];
var s = "";
foreach (var x, y in sl) s = s + x + y;
var big = ["p", "q", "r"];
var r2 = [big[1:3], ["s", "t"]];
foreach (var x, y in r2) s = s + x + y;
var r3 = [split("u v", " "), ["w", "z"]];
foreach (var x, y in r3) s = s + x + y;
var r4 = [[big[1:3], "k"], [["m"], "l"]];
var m = 0;
foreach (var x, y in r4) m += len(x);
var r5 = [[0, "x"], [1, "y"]];
try { var qq = [1]; qq[5] = 1; }
catch (OutOfBoundsEx as e) { r5[0][0] = e; }
foreach (var x, y in r5) s = s + y;
print("declines", s, m);

var r6 = [["a", "b"], ["c"]];
try { foreach (var x, y in r6) s = s + x; }
catch (TypeErrorEx as e) { print("strict  ", e); }
var big2 = ["p", "q"];
var r7 = [big2[0:1]];
try { foreach (var x, y in r7) s = s + x + y; }
catch (TypeErrorEx as e) { print("view    ", e); }
