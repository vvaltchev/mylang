# The constant-MULTIPLIER strength reduction (#100, div_magic's sibling):
# `x * 2^k` becomes IntShlRI at the BYTECODE level (specialize_arith_ops),
# and the JIT emits lea / shl+neg / mov+shl+add/sub for the other planned
# forms (mul_plan, jit.cpp). The VALUES are supposed to be identical -
# every form is exact mod 2^64, hence exact under -fwrapv - so this
# program is only meaningful run through corpus_diff, which compares it
# against the tree-walker's C++ `*`.
#
# Every plan shape, one line per multiplier: 0 / 1 / -1 (xor, keep, neg),
# powers of two incl. a big one (bytecode shl), their negatives (shl+neg),
# 3/5/9 and negatives (lea, lea+neg), 3|5|9 times 2^k (lea+shl),
# 2^k+1 (shl_add: 17, 33) and 2^k-1 (shl_sub: 7, 31, 8191), plus
# multipliers NO plan serves (11, 100, 1103515245 - the imul fallback)
# and one past imm32 (the movabs path). The value list covers both signs,
# both INT64 extremes and wraparound (INT64_MAX * 3 wraps; a plan that
# missed a mod-2^64 identity would diverge from the tree-walker here).
var acc = 0;
var ns = [0,1,2,3,4,7,8,9,15,16,17,99,100,101,255,256,1023,1024,123456789,1000000006,2147483647,(0 - 1),(0 - 2),(0 - 3),(0 - 4),(0 - 7),(0 - 8),(0 - 9),(0 - 15),(0 - 16),(0 - 17),(0 - 99),(0 - 100),(0 - 101),(0 - 255),(0 - 256),(0 - 123456789),(0 - 2147483647),9223372036854775807,(0 - 9223372036854775807)];
foreach (var n in ns) acc = acc + n * 0 + n * 1 + n * (0 - 1);
foreach (var n in ns) acc = acc + n * 2 + n * 8 + n * 1024 + n * 4611686018427387904;
foreach (var n in ns) acc = acc + n * (0 - 2) + n * (0 - 8) + n * (0 - 1024);
foreach (var n in ns) acc = acc + n * 3 + n * 5 + n * 9;
foreach (var n in ns) acc = acc + n * (0 - 3) + n * (0 - 5) + n * (0 - 9);
foreach (var n in ns) acc = acc + n * 6 + n * 10 + n * 12 + n * 40 + n * 72;
foreach (var n in ns) acc = acc + n * 17 + n * 33 + n * 65537;
foreach (var n in ns) acc = acc + n * 7 + n * 31 + n * 8191;
foreach (var n in ns) acc = acc + n * 11 + n * 100 + n * 1103515245;
foreach (var n in ns) acc = acc + n * (0 - 31) + n * (0 - 17);
foreach (var n in ns) acc = acc + n * 68719476736;
print("mul-strength acc:", acc);
