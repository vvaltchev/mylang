# Float ops that CALL C++ or libm with a float argument, in runs that pin
# float locals: fmod (`%`), pow/sqrt/exp, a compound element `%=` (the
# store helper takes its value in xmm0) and `/=`. The SysV float ABI
# (xmm0/xmm1) is not the float staging pair - under the #107 enumerator
# the stage moves off xmm0/xmm1 and a float pin can land in xmm0, so a
# site that confused the two computed with the pin's value (2026-10-02).
# Run it through tests/int_enum.py; the default run checks the values.
var a = 0.5;
var b = 1.25;
var c = 3.0;
var n = int(runtime(40));
for (var i = 0; i < n; i++) {
    a = a + 0.25;
    b = b * 1.01;
    c = c % 1.7 + a;
    a = a % 2.5;
    b = b + pow(a, 2.0) * 0.01 + sqrt(b) * 0.001;
    c = c + exp(0.01) - floor(c) * 0.0;
}
print(a, b, c);
var f = [0.0, 0.0, 0.0, 0.0];
var s = 0.0;
for (var i = 0; i < 4; i++) {
    f[i] = s;
    s = s + 1.5;
    f[i] %= 1.1;
}
print(f);
var z = 0.0;
for (var i = 0; i < n; i++) {
    z = z + 0.5;
    if (z / 2.0 > 100.0) { z = 0.0; }
    var w = z % 3.0;
    z = z + w * 0.0;
}
print(z);
var g = [1.0, 2.0, 3.0, 4.0];
var d = 1.0;
for (var i = 0; i < 4; i++) {
    d = d + 0.5;
    g[i] /= d;
    g[i] += d * 0.25;
}
print(g, d);
