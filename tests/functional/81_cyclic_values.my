# Values that contain themselves (README, *Values that contain
# themselves*; plans/reference-cycles.md, Part A). Arrays, dicts and boxed
# structs are references, so `append(a, a)` builds an array that holds
# itself, and every walk over such a value must terminate - printing,
# `==`, `hash`, a dict key, a deep copy, a constant's value. Each of them
# overflowed the C stack before (a SIGSEGV in a release build).
#
# LEAKS: reference counting cannot free a cycle, so a cycle this program
# builds is BROKEN at the end (pop / erase), or LeakSanitizer and the INT
# object census would report it. Two cycles here cannot be broken by any
# program - the cyclic constant C and the cyclic dict key are FROZEN
# (read-only) - and the interpreter frees those when the program ends.

struct Node { int v; dyn? next; }

# a ring: the array is its own second element (dynarray: `[1]` is a flat
# int array under -nti, which has no type hints, and cannot hold an array)
var dyn a = dynarray([1]);
append(a, a);

# 1. printing: a container already being printed further up is [...],
#    {...} or Name(...); one shared at two places, not on the path, is
#    printed at each
assert(str(a) == "[1, [...]]");
assert(str([a, a]) == "[[1, [...]], [1, [...]]]");
assert(str(clone(a)) == "[1, [1, [...]]]");    # a fresh top, then the ring
var dyn d1 = {};
d1["self"] = d1;
assert(str(d1) == "{\"self\": {...}}");
var dyn box = [];
var s = Node(1, box);
append(box, s);          # box -> s's object -> box
assert(str(s) == "Node(v: 1, next: [Node(...)])");
assert(str(box) == "[Node(v: 1, next: [...])]");

# 2. == compares by SHAPE: a back edge must lead to the same depth on both
#    sides
var dyn b = dynarray([1]);
append(b, b);
assert(a == a);
assert(a == b && !(a != b));
assert([a] == [b]);
assert({"r": a} == {"r": b});
var dyn u = dynarray([1]);
var dyn u2 = [1, u];
append(u, u2);           # a ring of two: u -> u2 -> u
assert(a != u);          # the same unfolding, a different shape
assert(u == u2);         # two nodes alike: the same shape, shifted
assert(clone(a) != a);   # the clone closes the ring one level deeper
assert(a != [1, [1, [1]]]);
var dyn d2 = {};
d2["self"] = d2;
assert(d1 == d2);
var dyn box_b = [];
var sb = Node(1, box_b);
append(box_b, sb);
assert(s == sb && box == box_b);
assert(find([u, b], a) == 1);

# 3. hash agrees with == on every cyclic shape
assert(hash(a) == hash(b));
assert(hash([a]) == hash([b]));
assert(hash(u) == hash(u2));
assert(hash(d1) == hash(d2));
assert(hash({"r": a}) == hash({"r": b}));
assert(hash(s) == hash(sb) && hash(box) == hash(box_b));

# 4. a cyclic value is a dict key: frozen (deep read-only) on insert, the
#    cycle included, and found by an equal value
var dyn m = {};
m[a] = "ring";
assert(m[b] == "ring" && len(m) == 1);
m[b] = "again";
assert(len(m) == 1 && m[a] == "again");
var dyn k0 = keys(m)[0];
assert(k0 == a && str(k0) == "[1, [...]]");
var dyn inner = k0[1];   # the frozen ring's back edge: frozen too
var frozen = 0;
try { inner[0] = 5; } catch (NotLValueEx) { frozen += 1; }
try { append(inner, 5); } catch (CannotChangeConstEx) { frozen += 1; }
assert(frozen == 2);
append(a, 7);            # the original moved on; the key did not
assert(len(m) == 1 && m[b] == "again" && len(k0) == 2);
pop(a);

# 5. deepclone reproduces the cycle INSIDE the copy; a value shared at two
#    places that is not on a cycle is still copied twice
var dyn c = deepclone(a);
assert(c == a && str(c) == "[1, [...]]");
assert(intptr(c[1]) == intptr(c) && intptr(c) != intptr(a));
c[0] = 99;
assert(a[0] == 1 && c[1][0] == 99);
var dyn s7 = [7];
var dyn dag = [s7, s7];
var dyn dc = deepclone(dag);
dc[0][0] = 8;
assert(dc[1][0] == 7 && s7[0] == 7);
var dyn dd = deepclone(d1);
assert(dd == d1 && str(dd) == "{\"self\": {...}}");
dd["x"] = 1;
assert(len(dd["self"]) == 2 && len(d1) == 1);
var dyn sc = deepclone(s);
assert(sc == s);
var dyn box_c = sc.next;
assert(intptr(box_c) != intptr(box) && box_c[0] == sc);

# 6. a cyclic CONSTANT, built by a pure function at compile time: frozen,
#    cycle included - and a `var` gets a mutable ring, the same whether the
#    call was folded at compile time or ran
pure func mk_ring(n) { var dyn r = [n, "x"]; r[1] = r; return r; }
var dyn r2 = mk_ring(1);             # folded: a constant argument
var dyn r3 = mk_ring(runtime(1));    # left to run time
const C = mk_ring(1);
assert(C == a && hash(C) == hash(a) && str(C) == "[1, [...]]");
assert(typestr(C) == "array<dyn>");
var dyn cv = C;
var cfrozen = 0;
try { cv[1][0] = 5; } catch (NotLValueEx) { cfrozen += 1; }
assert(cfrozen == 1);
assert(r2 == C && r3 == C && str(r2) == "[1, [...]]" && str(r3) == str(r2));
assert(intptr(r2[1]) == intptr(r2) && intptr(r3[1]) == intptr(r3));
r2[0] = 2;
r3[0] = 3;
assert(r2[1][0] == 2 && r3[1][0] == 3 && C[0] == 1);

# 7. a closure captures the array it is stored in: nothing walks into a
#    function, so the walks see only `<function>`
var dyn fs = [];
var dyn f = func [fs] () { return len(fs); };
append(fs, f);
assert(f() == 1 && str(fs) == "[<function>]" && fs == fs);
var dyn fsc = deepclone(fs);
assert(fsc[0] == f);

# 8. ordering is not defined on arrays: refused, not a crash
var refused = 0;
try { sort([a, b]); } catch (TypeErrorEx) { refused += 1; }
assert(refused == 1);

print("ok");

# break every cycle the program built (see LEAKS above)
pop(a);
pop(b);
pop(u);
erase(d1, "self");
erase(d2, "self");
pop(box);
pop(box_b);
pop(c);
erase(dd, "self");
pop(box_c);
pop(r2);
pop(r3);
pop(fs);
pop(fsc);
