# A const value BAKED AT PARSE TIME can hold a FuncObject - and the
# Identifier that named the function is GONE by the time the inferencer
# decides which TEMPLATE BASES are runtime-reachable: `const OPS = [sq];`
# is folded by the PARSER into one LiteralObj carrying the whole array.
# `value_used` was therefore false, the base was excluded from codegen as
# DEAD (#149), and an indirect call through the pool reached a chunk-less
# body: an ML_CHECK abort under ASSERTS, a walk of the FREED AST without
# them - while `-tw`, which never tears the tree down, printed the right
# answer. That makes it a RULE 2 divergence as well as a RULE 1 one.
#
# Arrays, dicts, NESTING and a struct's folded `const` member all bake
# one, and reachability is TRANSITIVE (a kept base's body names further
# templates, whose calls were never redirected to instances), so every
# one of those is exercised here. The -rt harness RETAINS its AST, so
# only a real script run can see any of it - hence a functional test.

pure func sq(x) => x * x;
pure func inc(x) => x + 1;
pure func twice(x) => inc(inc(x));   # reached only THROUGH chain's body
pure func chain(x) => twice(x) * 10;

const OPS = [sq, chain];
const BY_NAME = {"sq": sq, "chain": chain};
const NESTED = [[inc]];

struct Ops { const F = sq; }

var dyn a = OPS[runtime(0)];
var dyn b = OPS[runtime(1)];
var dyn c = BY_NAME[runtime("chain")];
var dyn d = NESTED[runtime(0)][0];
var dyn e = runtime(Ops.F);

print("const-pool func:", a(7), b(3), c(4), d(41), e(9));
