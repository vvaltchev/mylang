# Question 22 (maintainer, 2026-11-26; README *A read of a constant has
# the type of what it reads*): an expression whose value is FIXED at
# compile time has that value's exact type - an element, a member or a
# slice of a constant at constant indexes, keys or bounds, and a builtin
# call on constants. So a constant whose elements are of different kinds
# reads like a tuple, and `K[0]` of `[1, none]` is an int. Anything else
# - a run-time index, a read through a variable, a parameter, a foreach -
# has the container's element type, and a call to a user function the
# type the program gives it. It does not depend on folding: corpus_diff
# runs this program under -nc, where every read runs at run time. With
# no types (-nti) typestr names a value's run-time type, so the type
# checks are made in a typed run only.
var typed = typestr(runtime(0)) == "dyn";
var bad = 0;
func want(str what, opt dyn got, opt dyn exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}
func wantt(str what, str got, str exp) {
    if (typed)
        want(what, got, exp);
}

var r = int(runtime(1));
var z = int(runtime(0));

# ---- an element: its value's type, even where the element type is opt
const K = [1, none];
var e = K[0];
want("an int element adds", e + 1, 2);
wantt("K[0]", typestr(K[0]), "int");
wantt("K[1]", typestr(K[1]), "none");
wantt("K at a run-time index", typestr(K[z]), "int?");

# ---- a mixed constant reads like a tuple
const M = [1, "a", 2.5];
var i = M[0];
var s = M[1] + "!";
want("M[0]", i + 1, 2);
want("M[1]", s, "a!");
want("M[2]", M[2] * 2, 5.0);
wantt("M[2]'s type", typestr(M[2]), "float");
var dyn d = M[r];
wantt("M at a run-time index", typestr(d), "dyn");

# ---- inside an expression that is not constant
const CFG = {"name": "x", "n": 3};
var k = CFG.n + r;
want("a member beside a run-time value", k, 4);
wantt("...is an int", typestr(k), "int");
var j = M[0] + r;
want("an element beside a run-time value", j, 2);
wantt("...is an int", typestr(j), "int");

# ---- nested reads, an index a builtin computes, a struct's constant
const N = [[1, "x"], {"k": 2.5}];
wantt("N[0][1]", typestr(N[0][1]), "str");
want("N[1].k", N[1].k + 1, 3.5);
want("N[1][\"k\"]", N[1]["k"] * 2, 5.0);
want("an index a builtin computes", M[len(M) - 1] + 1, 3.5);
struct S { const T = [1, "s"]; }
want("a struct's constant member", S.T[0] + 1, 2);
wantt("...and its other element", typestr(S.T[1]), "str");

# ---- a slice at constant bounds, into a typed place
const P = [1, 2, "a"];
func count(array<int> a) => len(a);
wantt("a slice of ints", typestr(P[0:2]), "array<int>");
want("...enters an array<int>", count(P[0:2]), 2);
wantt("a slice of strs", typestr(P[2:3]), "array<str>");

# ---- a builtin call on constants (README *Const builtins*)
const D = {"a": 1};
var g = get(D, "a");
want("get of a constant", g + 1, 2);
want("get of a missing key", get(D, "zz"), none);
var w = find([4, 5], 5);
want("find of constants", w + 1, 2);
var dp = dict([[1, "b"]]);
wantt("dict(pairs)", typestr(dp), "dict<int,str>");

# ---- not fixed: a read through a variable, a parameter, a foreach
var a = M;
wantt("through a variable", typestr(a[0]), "dyn");
func first(b) => b[0];
wantt("through a parameter", typestr(first(M)), "dyn");
foreach (var el in M)
    wantt("through a foreach", typestr(el), "dyn");

# ---- a call to a user function keeps the type the program gives it
pure func pick(int n) {
    if (n > 0)
        return K[0];
    return K[1];
}
var x = pick(5);
wantt("a user function's result", typestr(x), "int?");
want("...and its value", x, 1);

assert(bad == 0);
print("ok");
