# The float literal pool loads each literal through a GP scratch at the
# fragment entry - after the entry pins are loaded. rcx is allocatable,
# so a run with enough live ints pins one in it; under the legacy
# allocator (MYLANG_JIT_OFF=lsra, which pins at ENTRY - corpus_diff
# --levers runs it) nine hot ints and a float literal made the literal's
# load overwrite the pinned slot. Found by the #107 P3 decision
# enumerator. The value is the oracle; a checked build's register
# tracker also aborts at the clobbering write.
func hot(int n) {
    var a = 1; var b = 2; var c = 3; var d = 4; var e = 5;
    var f = 6; var g = 7; var h = 8; var k = 9;
    var x = 0.5;
    for (var i = 0; i < n; i++) {
        a += i; b += a; c += b; d += c; e += d; f += e; g += f; h += g;
        k += h;
        x = x * 1.25 + 0.75;
        a = a & 65535; b = b & 65535; c = c & 65535; d = d & 65535;
        e = e & 65535; f = f & 65535; g = g & 65535; h = h & 65535;
        k = k & 65535;
    }
    return a + b + c + d + e + f + g + h + k + int(x) % 7;
}
var r = hot(int(runtime(1000)));
print(r);
assert(r == 263073);
