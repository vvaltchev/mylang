# A slice is a separate array the moment it is TAKEN, and every later copy
# of it - an assignment, an argument, an element stored or read back, a
# capture, a struct field - is the SAME array, as any array is (README,
# Slices; question 3 in plans/open-language-questions.md: Python's rule).
# Internally a slice stays a lazy view of the storage it was taken from;
# a write through ANY name holding it turns it into one ordinary array
# that all of them share. Each case asserts the result Python gives.

# taking a slice: writes never cross between it and its source
var a = [1, 2, 3, 4];
var s = a[1:3];
s[0] = 9;
assert(a == [1, 2, 3, 4] && s == [9, 3]);
a[2] = 7;
assert(s == [9, 3]);

# assigning it: one array, two names
var a2 = [1, 2, 3, 4];
var s2 = a2[1:3];
var t2 = s2;
t2[0] = 9;
assert(s2 == [9, 3] && t2 == [9, 3] && a2 == [1, 2, 3, 4]);

# passing it: the callee's writes are the caller's
func setz(x) { x[0] = 0; }
var a3 = [1, 2, 3, 4];
var s3 = a3[1:3];
setz(s3);
assert(s3 == [0, 3] && a3 == [1, 2, 3, 4]);

# growing it through another name (append, +=)
var a4 = [1, 2, 3, 4];
var s4 = a4[1:3];
var t4 = s4;
append(t4, 5);
assert(s4 == [2, 3, 5] && a4 == [1, 2, 3, 4]);
t4 += [6];
assert(s4 == [2, 3, 5, 6]);
var s4b = a4[0:2];
s4b += s4b;
assert(s4b == [1, 2, 1, 2] && a4 == [1, 2, 3, 4]);

# the full slice a[:] is a separate copy, shared by its own aliases
var a5 = [1, 2, 3];
var f5 = a5[:];
var g5 = f5;
g5[0] = 9;
assert(a5 == [1, 2, 3] && f5 == [9, 2, 3]);

# stored in an array and read back
var a6 = [1, 2, 3, 4];
var box6 = [a6[1:3]];
var u6 = box6[0];
u6[0] = 9;
assert(box6 == [[9, 3]] && a6 == [1, 2, 3, 4]);

# the same call on an untouched slice and on one already written
var a7 = [1, 2, 3, 4];
var s7 = a7[1:3];
setz(s7);
var s7b = a7[1:3];
append(s7b, 5);
setz(s7b);
assert(s7 == [0, 3] && s7b == [0, 3, 5] && a7 == [1, 2, 3, 4]);

# pop / erase / insert / sort / reverse through another name
var a8 = [5, 4, 3, 2, 1];
var s8 = a8[0:4];
var t8 = s8;
assert(pop(t8) == 2 && s8 == [5, 4, 3]);
erase(t8, 0);
assert(s8 == [4, 3]);
insert(t8, 0, 8);
assert(s8 == [8, 4, 3]);
sort(t8);
assert(s8 == [3, 4, 8]);
reverse(t8);
assert(s8 == [8, 4, 3] && a8 == [5, 4, 3, 2, 1]);

# a write to the source materializes the slice ONCE, for all its names
var a9 = [1, 2, 3, 4];
var p9 = a9[0:2];
var q9 = p9;
a9[0] = 9;
q9[1] = 7;
assert(a9 == [9, 2, 3, 4] && p9 == [1, 7] && q9 == [1, 7]);

# two slice EXPRESSIONS are two arrays, even with the same window; so are
# two empty slices, and a slice of a slice
var a10 = [1, 2, 3, 4];
var x10 = a10[0:2];
var y10 = a10[0:2];
x10[0] = 9;
assert(x10 == [9, 2] && y10 == [1, 2]);
var e10 = a10[9:10];
var f10 = a10[3:1];
append(e10, 5);
assert(e10 == [5] && f10 == [] && a10[2:0] == []);
var z10 = y10[0:1];
z10[0] = 6;
assert(y10 == [1, 2] && z10 == [6]);

# a capture and a struct field hold the same slice too
func capt() {
    var w = [1, 2, 3];
    var sw = w[0:2];
    var f = func [sw] () { sw[0] = 99; };
    f();
    return [sw, w];
}
assert(capt() == [[99, 2], [1, 2, 3]]);
struct B { int x; array<int> a; }
var big = [1, 2, 3, 4];
var b1 = B(int(runtime(0)), big[0:2]);
var b2 = b1;
append(b2.a, 9);
assert(b1.a == [1, 2, 9] && big == [1, 2, 3, 4]);

# a slice of a constant stays read-only through every name
const W = ["a", "b", "c"];
var sw = W[0:2];
var tw = sw;
var refused = false;
try { append(tw, "x"); } catch (CannotChangeConstEx) { refused = true; }
assert(refused && sw == ["a", "b"]);

# a loop over a slice sees a write made through another name, and raises
# when another name SHIFTS it (as a loop over any array does)
var a11 = [1, 2, 3, 4];
var s11 = a11[0:3];
var u11 = s11;
var seen = [];
foreach (var v in s11) { u11[2] = 30; append(seen, v); }
assert(seen == [1, 2, 30] && a11 == [1, 2, 3, 4]);
var a12 = [1, 2, 3, 4, 5];
var s12 = a12[1:4];
var u12 = s12;
var raised = false;
try {
    foreach (var v in s12) pop(u12);
} catch (OutOfBoundsEx) { raised = true; }
assert(raised && s12 == [2, 3] && a12 == [1, 2, 3, 4, 5]);

# a slice taken in a loop is a FRESH array each iteration - even where
# the slice could be computed once, a copy kept past the iteration must
# not be shared (an assignment and a pure function's result: escapes no
# other gate of the slice hoister refuses)
var a13 = [1, 2, 3, 4, 5];
func pass(x) { return x; }
var first = [0];
var last = [0];
for (var i = 0; i < 3; i++) {
    var sl = a13[1:3];
    if (i == 0) first = sl;
    last = pass(sl);
}
last[0] = 8;
assert(first == [2, 3] && last == [8, 3] && a13 == [1, 2, 3, 4, 5]);

# many slices of one array, each written through a second name
var a14 = range(400);
var parts = [];
for (var i = 0; i < 100; i++)
    append(parts, a14[i * 4:i * 4 + 4]);
foreach (var p in parts) {
    var al = p;
    al[0] = -1;
}
var tot = 0;
foreach (var p in parts) tot += p[0] + p[1];
assert(tot == -100 + sum(map(func(i) => i * 4 + 1, range(100))));
assert(a14[0] == 0 && a14[4] == 4);

print(s2, s3, s4, f5, box6, s8, q9, capt(), b1.a, seen, first, last,
      tot);
