# A constant call to a builtin has the exact type of the value it
# computes (question 22, maintainer 2026-11-26; README *Const builtins*):
# `get` and `find` of constants are the value they find (an `int`, or
# `none`), `dict(pairs)` of constant pairs the dict they make. It is the
# rule a read of a constant follows, and it does not depend on folding:
# corpus_diff runs this program under -nc too, where every call runs at
# run time. With no types (-nti) typestr names a value's run-time type,
# so the type checks are made in a typed run only.

var typed = typestr(runtime(0)) == "dyn";

var bad = 0;
func want(what, opt dyn got, opt dyn exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected " + str(exp));
        bad++;
    }
}
func refused(dyn f) {
    try { f(); } catch (TypeErrorEx) { return true; }
    return false;
}

const D = {"a": 1};
var g = get(D, "a");
if (typed)
    want("get's type", typestr(g), "int");
want("get's value", g + 1, 2);
want("get of a missing key", get(D, "z"), none);
var gz = get(D, "z");
if (typed)
    want("...is a none", typestr(gz), "none");
want("get! is not opt", typestr(get!(D, "a")), "int");

var w = find([1, 2], 2);
if (typed)
    want("find's type", typestr(w), "int");
want("find's value", w + 10, 11);
want("find of nothing", find([1, 2], 7), none);

# `a ?? b` is never none, whatever its left side's own type says: the
# parser decides a constant one and keeps the left side alone, which
# stands for the whole (README: `var n = maybe ?? 0;` is an int)
var n1 = get(D, "a") ?? 0;
want("get ?? default is not opt", typestr(n1), "int");
want("...and adds", n1 + 1, 2);
var n2 = find([4, 5], 5) ?? 0 - 1;
want("find ?? default is not opt", typestr(n2), "int");
want("...and adds", n2 + 1, 2);
var n3 = get(D, "z") ?? 7;
want("a missing key takes the default", n3 + 1, 8);

var d1 = dict([["a", 1]]);
if (typed)
    want("dict(pairs)'s type", typestr(d1), "dict<str,int>");
d1["b"] = 2;
want("dict(pairs) takes an int value", d1["b"], 2);
var dyn e1 = d1;
if (typed)
    want("...and refuses a str", refused(func [e1] () { e1["c"] = "s"; }),
         true);
var k = keys(dict([["x", 1], ["y", 2]]));
if (typed) {
    want("keys of it", typestr(k), "array<str>");
    want("...stored as strings", array_storage(k), "str");
    want("a default dict is typed by its default", typestr(dict(2.5)),
         "dict<dyn,float>");
}

# a `dyn` variable's array is general, built by a constant call too
var dyn dr = range(3);
dr[0] = "z";
want("a dyn range() takes any element", dr, ["z", 1, 2]);
var dyn dv = values(D);
dv[0] = "s";
want("a dyn values() takes any element", dv, ["s"]);

# a call over a call whose array the fold does not bake folds whole
const base = [3, 1, 2];
var tot = 0;
for (var i = 0; i < int(runtime(3)); i++)
    tot += sum(sort(base)) + len(reverse(base));
want("a constant call over a constant array call", tot, 27);

assert(bad == 0);
print("ok");
