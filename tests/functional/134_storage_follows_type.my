# Rule 4 (plans/strict-container-types.md): an array's storage follows
# its type - every array<int> / array<float> / array<bool> is flat,
# wherever the array is made. A builtin's new container (keys, values,
# map, filter, make_array, range, array) took its storage from the
# variable it was assigned to and from nothing else, so the same
# `keys(d)` was flat in `var k = keys(d)` and GENERAL as an argument, a
# result, a field or an element. An untyped run (-nti) has no types, so
# the storage is asserted on a typed run only; the values everywhere.
var typed = typestr(runtime(0)) == "dyn";
var bad = 0;
func want(str what, opt dyn got, opt dyn exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}
func flat(str what, dyn a, str kind) {
    if (typed)
        want(what, array_storage(a), kind);
}

var d = {1: 2, 3: 4};
var fd = {1: 2.5};
var bd = {true: false};
var xs = [1, 2, 3];

# ---- as an argument
flat("keys arg", keys(d), "int");
flat("values arg", values(d), "int");
flat("float values arg", values(fd), "float");
flat("bool keys arg", keys(bd), "bool");
flat("map arg", map(func(int x) => x * 2, xs), "int");
flat("map float arg", map(func(int x) => x * 0.5, xs), "float");
flat("filter arg", filter(func(int x) => x > 1, xs), "int");
func takes(array<int> a) => array_storage(a);
if (typed) {
    want("typed param", takes(keys(d)), "int");
    want("typed param map", takes(map(func(int x) => x + 1, xs)), "int");
}

# ---- as a function's result
func ks() => keys(d);
var r = ks();
flat("result", r, "int");
want("result values", str(r), "[1, 3]");

# ---- as a field and as an element
struct S { array<int> a; }
var s = S(keys(d));
flat("field", s.a, "int");
var e = [keys(d), values(d)];
flat("element", e[0], "int");
flat("element 2", e[1], "int");
want("element values", str(e), "[[1, 3], [2, 4]]");

# ---- iterating one inline still sees its values
var t = 0;
foreach (k in keys(d))
    t += k;
want("foreach inline", t, 4);
want("sum inline", sum(values(d)), 6);

# ---- a variable's right-hand side, as before
var kv = keys(d);
flat("variable", kv, "int");

assert(bad == 0);
print("ok");
