# A slice passed to a parameter the function writes through. The call's
# copy of a slice handle is its own view, which detaches on the write, so
# the caller's slice is unchanged; a plain array's copy shares its
# storage, so the write reaches the caller's array (README, slices). The
# AST inliner pasted the caller's NAME for such a parameter, so an
# inlined call wrote the caller's slice and `-ni` did not (RULE 2).
func blk(x) { x[0] = 77; return x[1]; }
func ex(x) => pop(x);
func w(x) { append(x, 9); return 1; }
func tl(y) { return w(y); }
func inc(x) { x[1]++; return 0; }

var a = [1, 2, 3, 4];
var u = a[0:2];
assert(blk(u) == 2 && u == [1, 2] && a == [1, 2, 3, 4]);
var v = a[1:3];
assert(ex(v) == 3 && v == [2, 3]);
var s = a[2:4];
assert(tl(s) == 1 && s == [3, 4]);
var t = a[0:3];
assert(inc(t) == 0 && t == [1, 2, 3]);

# a plain array: the write reaches it
var b = [5, 6];
assert(blk(b) == 6 && b == [77, 6]);
var c = [1, 2, 3];
assert(ex(c) == 3 && c == [1, 2]);
var d = [8];
assert(tl(d) == 1 && d == [8, 9]);

# in a loop, where the call is hot
var total = 0;
for (var i = 0; i < 5; i++) {
    var sl = a[i % 2:i % 2 + 2];
    total += blk(sl);
    assert(sl[0] != 77);
}
assert(total == 2 + 3 + 2 + 3 + 2);
print(a, u, v, s, t, b, c, d, total);
