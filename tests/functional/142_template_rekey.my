# A template call's instance is the one for its arguments' types as the
# compiler last saw them (#78). An argument may widen AFTER the call was
# redirected to an instance - a global another template later assigns a
# float to - and the call then moves to the instance for its new key.
# Until 2026-11-22 it stayed on the old one, whose parameter widened
# under the calls that kept their key: `f(3)` ran an instance typed
# float with the int 3 in it (typestr said "float", `x + 1` printed 4;
# with -ni the bind converted it, so the engines disagreed).
var typed = typestr(runtime(0)) == "dyn";
var bad = 0;
# (the expectations are the static types: -nti has none)
func want(str what, opt dyn got, opt dyn exp) {
    if (typed && got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}

# ---- two calls share an instance until one argument widens
var gv = 1;
func setg(y) { gv = y; return 0; }
func f(x) { return typestr(x) + " " + str(x + 1); }
var first = f(gv);
want("an int literal keeps its own instance", f(3), "int 4");
setg(2.5);
want("the widened global", f(gv), "float 3.500000");
want("the widened global, first call", first, "float 2.000000");
want("a bool", f(true), "bool 2");

# ---- every call of an instance moves: the old one is unused
var hv = 1;
func seth(y) { hv = y; return 0; }
func g(x) { var t = x + 1; return t; }
want("its only call moved", str(g(hv)), "2.000000");
seth(0.5);
want("a body the unused instance would not type", str(g(hv)),
     "1.500000");
want("the program sees the live instances only",
     len(specializations(g)), 1);

# ---- a lambda template
var kv = 1;
func setk(y) { kv = y; return 0; }
var lam = func(x) { return typestr(x); };
want("a lambda's int call", lam(3), "int");
want("a lambda's widened call", lam(kv), "float");
setk(0.25);

# ---- two empty arrays filled later by templates (they shared a key, so
# one array's instance was handed the other's elements)
func t(x) { return typestr(x); }
var a1 = [];
var a2 = [];
var t1 = t(a1);
var t2 = t(a2);
func fill1(v) { append(a1, v); return 0; }
func fill2(v) { append(a2, v); return 0; }
fill1("s");
fill2(3);
want("the first array", t1, "array<str>");
want("the second array", t2, "array<int>");

# ---- a key with an unsettled part is never re-keyed: two closure
# templates key alike while their returns are withheld, and the site
# that may reach either runs its untyped body (rule 8.2)
var cb = 0;
func ap(fn, v) { var r = fn(v); return r; }
var gq = func [cb] (x) { return typestr(x); };
var mq = func [cb] (x) { return x + 1; };
var rq0 = ap(gq, 1);
var rq = ap(mq, 1);
want("the shared site's result", typestr(rq), "dyn");
want("the untyped body ran", rq0, "dyn");
want("its value", rq + 1, 3);

assert(bad == 0);
print("ok");
