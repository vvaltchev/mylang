# A catch clause catches a struct by IDENTITY (question 25, README
# *Exceptions*): the struct its name resolves to where the clause is
# written, as the type in `Err e;` does. Three structs named Err below are
# three types; a function's private struct is not caught by name outside
# it, only by the fallback `catch (dyn as e)`, which binds whatever it
# caught. Clauses used to compare names, so `catch (Err)` caught all three
# and `e.ok` failed at run time inside the catch body.

var bad = 0;
func want(what, opt got, exp) {
    if (got != exp) {
        print("FAIL " + what + ": got " + str(got) + ", expected "
              + str(exp));
        bad++;
    }
}

func rt(x) => runtime(x);

func a(n) { struct Err { int code; } throw Err(n); }
func b(s) { struct Err { str text; } throw Err(s); }
struct Err { bool ok; }
func c() { throw Err(rt(true)); }

# a's private Err passes the top-level clause by
func catches_a() {
    try { a(rt(7)); } catch (Err as e) { return "wrong " + str(e.ok); }
    catch (dyn as e) { return "fallback " + str(e.code); }
}
want("private struct", catches_a(), "fallback 7");

var got = "";
try { b(rt("x")); } catch (Err) { got = "wrong"; }
catch (dyn as e) { got = str(e.text); }
want("another private struct", got, "x");

# the top-level Err, and its variable has that type
try { c(); } catch (Err as e) { got = typestr(e) + " " + str(e.ok); }
want("top-level", got, "Err true");

# through an alias: the alias's struct
const T = Err;
try { c(); } catch (T as e) { got = "alias " + str(e.ok); }
want("alias", got, "alias true");

# a function's own struct, caught inside the function
func inner() {
    struct P { int v; }
    try { throw P(rt(3)); } catch (P as p) { return p.v; }
}
want("inside", inner(), 3);

# a struct declared further down (it binds at scope entry)
try { throw Late(rt(1)); } catch (Late as l) { got = "late " + str(l.v); }
want("declared below", got, "late 1");
struct Late { int v; }

# several types in one clause: the variable is dynamic
struct A1 { int v; }
struct B1 { str s; }
func pick(int k) {
    if (k == 0)
        throw A1(rt(4));
    throw B1(rt("q"));
}
foreach (var k in [0, 1]) {
    try { pick(rt(k)); } catch (A1, B1 as e) { got = str(e); }
    want("multi " + str(k), got, k == 0 ? "A1(v: 4)" : "B1(s: \"q\")");
}

# a built-in exception: by name; the fallback binds it as well
try { print(1 / rt(0)); } catch (DivisionByZeroEx as e) { got = str(e); }
want("builtin", got, "<Exception(DivisionByZeroEx)>");
try { print([1][rt(5)]); } catch (dyn as e) { got = str(e); }
want("builtin fallback", got, "<Exception(OutOfBoundsEx)>");

# a struct named like a built-in exception is its own type: the clause
# naming the built-in does not catch it
func odd() { struct TypeErrorEx { int z; } throw TypeErrorEx(rt(9)); }
try {
    try { odd(); } catch (TypeErrorEx) { got = "wrong"; }
} catch (dyn as e) { got = "outer " + str(e.z); }
want("builtin's name", got, "outer 9");

# the fallback is the last clause, after the typed ones
try { c(); } catch (A1) { got = "wrong"; } catch (dyn as e) {
    got = "last " + str(e.ok);
}
want("last clause", got, "last true");

# ...and neither does a BOX of such a struct, which a `dyn` can throw: a
# built-in exception's name catches no struct at all (a box<P> is not a P
# either, so only the fallback catches it)
func odd_box() {
    struct TypeErrorEx { int z; }
    var dyn b = box(TypeErrorEx(rt(9)));
    throw b;
}
try {
    try { odd_box(); } catch (TypeErrorEx) { got = "wrong"; }
} catch (dyn as e) { got = "outer " + str(e); }
want("builtin's name, boxed", got, "outer box(TypeErrorEx(z: 9))");

# through an alias where the struct's own name means something else: a
# parameter named like the struct does not hide the alias (README, *Type
# aliases*), and an alias of a struct a function declared has no other
# name here. The clause used to be rewritten to the struct's own name,
# which is not a type in either place.
func hid(Err) {
    try { c(); } catch (T as e) { return "alias " + str(e.ok) + str(Err); }
    return "none";
}
want("alias, struct name hidden", hid(rt(3)), "alias true3");
pure func mk() { struct Made { int v; } return Made; }
const M = mk();
func thr_m() { throw M(rt(4)); }
try { thr_m(); } catch (M as e) { got = "made " + str(e.v); }
want("alias of a function's struct", got, "made 4");
# ...in a function declared above the alias, whose body is compiled first
func in_func() {
    try { thr_m(); } catch (M as e) { return "func " + str(e.v); }
    return "none";
}
want("alias, in a function", in_func(), "func 4");

# A call the COMPILER runs catches as the same call does at run time
# (README, *A call at compile time computes what it computes at run
# time*): by identity. The clauses below are resolved while compiling,
# with no inferred program to ask, and used to compare names there.
pure func p_thr(n) { struct PErr { int code; } throw PErr(n); }
# PErr is declared below the constant, so nothing thrown now can be one
pure func p_later(n) {
    try { p_thr(n); } catch (PErr) { return "named"; }
    catch (dyn as e) { return "fallback " + str(e.code); }
    return "none";
}
const C_LATER = p_later(7);
struct PErr { bool ok; }
want("compile time, declared below", C_LATER, "fallback 7");
want("run time, declared below", p_later(rt(7)), "fallback 7");
# its own PErr2, declared after the try in the same block
pure func p_own(n) {
    try { p_thr2(n); } catch (PErr2) { return "named"; }
    catch (dyn as e) { return "fallback " + str(e.code); }
    struct PErr2 { str s; }
    return "none";
}
pure func p_thr2(n) { struct PErr2 { int code; } throw PErr2(n); }
const C_OWN = p_own(8);
want("compile time, own struct", C_OWN, "fallback 8");
want("run time, own struct", p_own(rt(8)), "fallback 8");
# the struct it names, thrown as a constant no function constructs; an
# alias; a built-in exception; a private struct named like a built-in one
struct CErr { int v; }
const C_VAL = CErr(5);
const CT = CErr;
pure func p_val(n) { if (n > 0) throw C_VAL; return 0; }
pure func p_named(n) {
    try { p_val(n); } catch (CErr as e) { return "named " + str(e.v); }
    catch { return "all"; }
    return "none";
}
pure func p_alias(CErr) {
    try { p_val(CErr); } catch (CT as e) { return "alias " + str(e.v); }
    catch { return "all"; }
    return "none";
}
pure func p_div(n) {
    try { return str(10 / n); } catch (DivisionByZeroEx) { return "div"; }
}
pure func p_odd(n) { struct TypeErrorEx { int z; } throw TypeErrorEx(n); }
pure func p_builtin(n) {
    try { p_odd(n); } catch (TypeErrorEx) { return "wrong"; }
    catch (dyn as e) { return "fallback " + str(e.z); }
    return "none";
}
const C_NAMED = p_named(1);
const C_ALIAS = p_alias(1);
const C_DIV = p_div(0);
const C_BUILTIN = p_builtin(6);
want("compile time, named", C_NAMED, "named 5");
want("run time, named", p_named(rt(1)), "named 5");
want("compile time, alias", C_ALIAS, "alias 5");
want("run time, alias", p_alias(rt(1)), "alias 5");
want("compile time, built-in", C_DIV, "div");
want("run time, built-in", p_div(rt(0)), "div");
want("compile time, built-in's name", C_BUILTIN, "fallback 6");
want("run time, built-in's name", p_builtin(rt(6)), "fallback 6");

assert(bad == 0);
print("ok");
