# #97 R4: a frameless LEAF that makes no frame-reading C++ call on its
# normal-return path never writes the vframe cell, and its call site
# does not restore it. Two paths still reach C++ from such a leaf and
# must not break the caller's view:
#  - an ARRAY result declines to jit_ret_norec (the window is found
#    from rbp, not from the unpublished vframe);
#  - a raise publishes, and the site's exception path restores.
# After each call main runs builtins that read its own frame.
func pick(array<int> a, int k) {
    var r = 0;
    for (var j = 0; j < k; j++)
        r += j * 3;
    if (r < 0)
        return a;
    return a;
}

func risky(int k) {
    var r = 0;
    for (var j = 0; j < 3; j++)
        r += j;
    return (r + 100) / (k % 4);
}

var a = [1, 2, 3, 4];
var s = 0;
var caught = 0;
for (var i = 0; i < 40; i++) {
    var b = pick(a, runtime(3));
    s += b[1] + len(b);
    try {
        s += risky(i);
    } catch (DivisionByZeroEx) {
        caught++;
    }
    s += len(str(s)) + i;
}
print(s, caught);
