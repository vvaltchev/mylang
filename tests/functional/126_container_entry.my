# Q2 increment 3 (plans/typed-containers.md, section 3, decision A): a
# container ENTERING a typed place - a parameter, a struct field, an
# element of a typed container - enters by its OWN type, not by what it
# holds right now (README, "A container keeps its type"). Every component
# must be the container's exactly - a `dyn` one too, which is a type of
# its own (rule 1, plans/strict-container-types.md; decision A let it
# take anything until 2026-11-20). An untyped container (only `dyn`
# reaches it) is checked by what it holds and then TAKES the place's
# type, so a later store through a `dyn` name is checked against it. A
# constant's container is read-only: it is checked by what it holds and
# takes none.
#
# Without inference (-nti) no container has a type, so nothing below is
# refused there: every refusal is asserted in a typed run only.
struct S { array<int> a; }

var typed = typestr(runtime(0)) == "dyn";
var refused = 0;

func takes(array<int> p) => len(p);
func takes_opt(array<int?> p) => len(p);
func takes_dyn(array<dyn> p) { p[0] = "s"; }
func takes_nested(array<array<dyn>> p) => len(p);
func takes_dict(dict<str, int?> p) => len(p);
func takes_dict_dyn(dict<str, dyn> p) => len(p);

# an array<dyn> enters no array<int>, even holding only ints
var dyn d = [1, 2];
try { takes(d); } catch (TypeErrorEx) { refused++; }
try { var s = S(d); } catch (TypeErrorEx) { refused++; }
assert(!typed || refused == 2);

# invariance: an array<int> is no array<int?> (the place would let a
# none in), nor an array<dyn> (rule 1)
refused = 0;
var b = [1, 2];
var dyn x = b;
try { takes_opt(x); } catch (TypeErrorEx) { refused++; }
try { takes_dyn(x); } catch (TypeErrorEx) { refused++; }
assert(!typed || str(b) == "[1, 2]");
assert(takes(x) == 2);
assert(!typed || refused == 2);

# below the top, only a `dyn` component is a wildcard: array<array<int>>
# does not enter array<array<dyn>>, whose elements take any array
refused = 0;
var m = [[1], [2]];
var dyn dm = m;
try { takes_nested(dm); } catch (TypeErrorEx) { refused++; }
array<array<dyn>> mm = [[1], ["s"]];
var dyn dmm = mm;
assert(takes_nested(dmm) == 2);
var dyn dmixed = [[1], ["s"]];       # made where dyn is: an array<dyn>
try { takes_nested(dmixed); } catch (TypeErrorEx) { refused++; }
assert(!typed || refused == 2);

# a dict, by its key and value types
refused = 0;
var dd = {"k": 1};
var dyn ddd = dd;
try { takes_dict(ddd); } catch (TypeErrorEx) { refused++; }
try { takes_dict_dyn(ddd); } catch (TypeErrorEx) { refused++; }
assert(!typed || refused == 2);

# an untyped container - nested in a `dyn` element - fits by what it
# holds, and takes the type of the place it entered
refused = 0;
array<dyn> ad = [[1, 2], [3]];
var dyn inner = ad[0];
assert(takes(inner) == 2);
try { inner[0] = "s"; } catch (TypeErrorEx) { refused++; }
try { ad[0][1] = "s"; } catch (TypeErrorEx) { refused++; }
assert(!typed || str(ad) == "[[1, 2], [3]]");
assert(!typed || refused == 2);

# stored through `dyn` into a typed container's element, it takes the
# element's type there
refused = 0;
var dyn other = ad[1];
dm[0] = other;
try { other[0] = "s"; } catch (TypeErrorEx) { refused++; }
assert(!typed || str(m) == "[[3], [2]]");
assert(!typed || refused == 1);

# a container the RUNTIME builds that a typed name reaches carries that
# type too: argv is an array<str>, layout(S).fields an array<StructField>
refused = 0;
var dyn av = argv;
try { append(av, 5); } catch (TypeErrorEx) { refused++; }
struct L2 { int x; }
var dyn lf = layout(L2).fields;
try { append(lf, 5); } catch (TypeErrorEx) { refused++; }
var dyn lr = layout(runtime(L2)).fields;
try { append(lr, 5); } catch (TypeErrorEx) { refused++; }
assert(!typed || refused == 3);

# a constant's container is read-only: it enters by what it holds
const K = [1, 2];
var dyn k = K;
assert(takes(k) == 2);

# a slice is an array of its own (question 3), and a type is kept on the
# storage slices share: an untyped SLICE entering takes the place's type
# (all its names do), one nested in an entering container too, and the
# parent of a live slice takes it without typing the slice
func st(dyn d) {
    try { d[0] = 1; return "ok"; } catch (TypeErrorEx) { return "no"; }
}
func takes_s(array<str> p) => len(p);
func takes_ss(array<array<str>> p) => len(p);
array<dyn> sbox = [["a", "b", "c"], ["d", "e", "f"], ["g", "h", "i"]];
var dyn sl = sbox[0][0:2];
var dyn sl2 = sl;
assert(takes_s(sl) == 2);
var dyn nsl = sbox[1][0:2];
array<dyn> nest = [[nsl]];
var dyn nouter = nest[0];
assert(takes_ss(nouter) == 1);
var dyn par = sbox[2];
var dyn psl = par[1:3];
assert(takes_s(par) == 3);
var sv = [st(sl2), st(nsl), st(par), st(psl)];
assert(str(sv) == (typed ? "[\"no\", \"no\", \"no\", \"ok\"]"
                          : "[\"ok\", \"ok\", \"ok\", \"ok\"]"));
assert(str(psl) == "[1, \"i\"]" && str(par) == (typed
       ? "[\"g\", \"h\", \"i\"]" : "[1, \"h\", \"i\"]"));
print("ok");
