# a recursion whose body calls a builtin (max) at every level (depth ~500)
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

func climb(int n, int h) {
    if (n <= 0)
        return h;
    return climb(n - 1, max(h, (n * 37) % 1009) - 1);
}

var K = 2000 * scale;
var s = 0;
for (var k = 0; k < K; k++)
    s = (s + climb(500 + k % 7, k % 11)) % 1000000007;
print("result:", s);
