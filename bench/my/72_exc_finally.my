# try/finally on the NORMAL (non-throwing) path — measures the finally-region
# cost (setup + the always-run finally + the suspend/resume machinery) with NO
# exception in flight.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

var N = 500000 * scale;
var s = 0;
var fin = 0;

for (var i = 0; i < N; i++) {
    try {
        s = (s + i) % 1000000007;
    } finally {
        fin++;
    }
}

print("result:", s, fin);
