# struct field-sum foreach: iterate a flat array<Struct> and sum its scalar
# fields, amplified by an outer rep loop. Exercises the DIRECT struct-field read
# from the array bytes (no per-element StructObject / memcpy) - distinct from
# 58_structs (mixed) and 64_struct_create (construction).
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

struct Point3 { int x; int y; int z; }

var a = [];
for (var i = 0; i < 2000; i++)
    append(a, Point3(i, i * 2, i * 3));

var s = 0;
var reps = 2000 * scale;
for (var r = 0; r < reps; r++)
    foreach (var p in a)
        s = (s + p.x + p.y + p.z) % 1000000007;

print("result:", s);
