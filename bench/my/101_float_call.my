# FLOAT ARGUMENTS ACROSS A CALL (#97 REGCALL step 4): four float
# recurrences plus ONE call per iteration to a float helper too big to
# inline - the float twin of 97_regs_int_call. Its parameters arrive in
# xmm registers, and the one read often enough is pinned where it lands.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

func blend(float a, float b) {
    var t = a * 0.75 + b * 0.25;
    t = t + a * b * 0.0001;
    if (t > 1000.0)
        t = t - 1000.0;
    return t * 0.999 + a * 0.0005;
}

func drive(int n) {
    var x0 = 1.0; var x1 = 2.0; var x2 = 3.0; var x3 = 4.0;
    var s = 0.0;
    for (var i = 0; i < n; i++) {
        x0 = x0 * 0.5 + 1.0;
        x1 = x1 * 0.25 + x0;
        x2 = x2 * 0.125 + x1;
        x3 = x3 * 0.5 + x2 * 0.5;
        s = blend(s, x3);
    }
    return int(s * 1000.0) + int(x0 + x1 + x2 + x3);
}

print("result:", drive(500000 * scale));
