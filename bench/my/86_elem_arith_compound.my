# Compound arith stores on FLAT array elements: a[j] += / -= / *= / /= / %=
# in a hot loop - the #92/#95 inline element-store tier's COMPOUND arm,
# which no other bench reaches (they all spell a[j] = a[j] OP x, a read +
# a plain store). Values stay non-negative so /= and %= (truncating here,
# flooring in Python) agree, and bounded so 64-bit wrap never fires.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

var N = 400000 * scale;
var a = array(64, 0);                        # flat array<int>
for (var i = 0; i < 64; i++)
    a[i] = i * 17 + 3;

for (var t = 0; t < N; t++) {
    var j = t & 63;
    a[j] += (t & 1023) + 256;
    a[j] -= (t >> 3) & 255;
    a[j] *= 3;
    a[j] /= 2;
    a[j] %= 65536;
}

var s = 0;
for (var i = 0; i < 64; i++)
    s += a[i];
print("result:", s);
