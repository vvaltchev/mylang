# struct creation: construct structs STANDALONE (not into an array) in a loop,
# read their fields, and accumulate - measures the construction + field-read
# path. Distinct from 58_structs, which builds a flat array<Struct> via append
# (EmplaceStruct); here each Point/Vec3 is a fresh standalone value.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

struct Point { int x; int y; }
struct Vec3 { float x; float y; float z; }

var N = 500000 * scale;
var sx = 0;
var fs = 0.0;

for (var i = 0; i < N; i++) {
    var p = Point(i, i * 2);                  # standalone int-POD construction
    sx += p.x + p.y;
    var v = Vec3(i * 1.0, i * 2.0, i * 3.0);  # standalone float-POD construction
    fs += v.x + v.y + v.z;
}

print("result:", sx, int(fs));
