# A RUN THAT CALLS, WITH A HOT LOOP THAT DOES NOT (#124(b)): an outer
# loop calls a helper once per iteration; an inner loop runs eight int
# recurrences seeded from its result. Only the outer accumulator is live
# across the call, so the inner loop may pin in caller-saved registers
# too - before #124 any MyLang call capped the WHOLE run at the four
# callee-saved ones.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

func seed(int k) {
    var x = k * 2654435761 + 12345;
    x = x ^ (x >> 13);
    if (x < 0)
        x = 0 - x;
    return x % 65521;
}

func drive(int n) {
    var total = 0;
    for (var o = 0; o < n; o++) {
        var b = seed(o);
        var a0 = b; var a1 = b + 1; var a2 = b + 2; var a3 = b + 3;
        var a4 = b + 4; var a5 = b + 5; var a6 = b + 6; var a7 = b + 7;
        for (var i = 0; i < 100; i++) {
            a0 = (a0 * 3 + i) & 65535;
            a1 = (a1 ^ (i >> 1)) + 7;
            a2 = (a2 + a0) & 65535;
            a3 = (a3 * 5 + 1) & 65535;
            a4 = (a4 ^ a1) & 65535;
            a5 = (a5 + i * 2) & 65535;
            a6 = (a6 * 7 + a2) & 65535;
            a7 = (a7 + a3 + a5) & 65535;
        }
        total = (total + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7)
                % 1000000007;
    }
    return total;
}

print("result:", drive(10000 * scale));
