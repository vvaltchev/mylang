# REGISTER PRESSURE, REFERENCE locals: 8 array PARAMETERS, each
# read once per iteration. They are non-escaping, so #93/#94 marks
# them BORROWED - a reference whose refcount is somebody else's
# problem, i.e. exactly the case whose data pointer could live in a
# machine register. Today each read re-derives it from the 48-byte
# frame slot. Four-element arrays and an & mask: no division, no
# cache pressure, no mispredicts.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

func work(array<int> b0, array<int> b1, array<int> b2, array<int> b3, array<int> b4, array<int> b5, array<int> b6, array<int> b7, int n) {
    var s = 0;
    for (var i = 0; i < n; i++) {
        var j = i & 3;
        s = s + b0[j];
        s = s + b1[j];
        s = s + b2[j];
        s = s + b3[j];
        s = s + b4[j];
        s = s + b5[j];
        s = s + b6[j];
        s = s + b7[j];
        if ((i & 1) == 0)
            s = s + 1;
    }
    return s;
}

var v0 = [1, 2, 3, 4];
var v1 = [2, 3, 4, 5];
var v2 = [3, 4, 5, 6];
var v3 = [4, 5, 6, 7];
var v4 = [5, 6, 7, 8];
var v5 = [6, 7, 8, 9];
var v6 = [7, 8, 9, 10];
var v7 = [8, 9, 10, 11];
var N = 2000000 * scale;
print("result:", work(v0, v1, v2, v3, v4, v5, v6, v7, N));
