# REGISTER PRESSURE ACROSS A CALL (#124(b)): eight int locals, each with
# its own loop-carried recurrence, plus ONE call per iteration to a helper
# too big to inline. A run containing a MyLang call may pin only in the
# four callee-saved registers, so four of the eight live in memory.
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

func mix(int a, int b) {
    var x = a * 31 + b;
    x = x ^ (x >> 7);
    x = x * 5 + 3;
    if (x < 0)
        x = 0 - x;
    return x % 1000003;
}

func drive(int n) {
    var a0 = 1; var a1 = 2; var a2 = 3; var a3 = 4;
    var a4 = 5; var a5 = 6; var a6 = 7; var a7 = 8;
    var s = 0;
    for (var i = 0; i < n; i++) {
        a0 = (a0 * 3 + i) & 65535;
        a1 = (a1 ^ (i >> 1)) + 7;
        a2 = (a2 + a0) & 65535;
        a3 = (a3 * 5 + 1) & 65535;
        a4 = (a4 ^ a1) & 65535;
        a5 = (a5 + i * 2) & 65535;
        a6 = (a6 * 7 + a2) & 65535;
        a7 = (a7 + a3 + a5) & 65535;
        s = (s + mix(i, a4)) % 1000000007;
    }
    return s + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
}

print("result:", drive(500000 * scale));
