# a recursive function that also calls a helper at every level (depth ~500)
var scale = 1;
if (len(argv) > 0)
    scale = int(argv[0]);

func weight(int n) {
    var x = n * 7 + 3;
    x = x ^ (x >> 3);
    if (x < 0)
        x = 0 - x;
    return x % 1009;
}

func walk(int n) {
    if (n <= 0)
        return 0;
    return (weight(n) + walk(n - 1)) % 1000000007;
}

var K = 2000 * scale;
var s = 0;
for (var k = 0; k < K; k++)
    s = (s + walk(500 + k % 7)) % 1000000007;
print("result:", s);
